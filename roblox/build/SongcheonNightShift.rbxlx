<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<External>null</External>
	<External>nil</External>
	<Item class="Workspace" referent="RBX00000000">
		<Properties>
			<string name="Name">Workspace</string>
			<bool name="StreamingEnabled">false</bool>
			<float name="FallenPartsDestroyHeight">-500</float>
		</Properties>
	</Item>
	<Item class="Lighting" referent="RBX00000001">
		<Properties>
			<string name="Name">Lighting</string>
			<float name="ClockTime">22</float>
			<bool name="GlobalShadows">true</bool>
			<token name="Technology">4</token>
		</Properties>
	</Item>
	<Item class="ReplicatedStorage" referent="RBX00000002">
		<Properties>
			<string name="Name">ReplicatedStorage</string>
		</Properties>
		<Item class="ModuleScript" referent="RBX00000003">
			<Properties>
				<string name="Name">AtlasText</string>
				<ProtectedString name="Source"><![CDATA[-- 손글씨 글자 그림 (tools/make_atlas.js 가 만든 아틀라스) 을 GUI 로 붙이는 도우미.
-- Config.TEXT_ATLAS_IDS 에 그림 ID 가 있으면 ImageLabel(아틀라스의 한 칸), 없으면 비슷한 색의 TextLabel 로 대신 보여 준다.
local RunService = game:GetService("RunService")
local Atlas = require(script.Parent:WaitForChild("TextAtlas"))
local Config = require(script.Parent:WaitForChild("Config"))

local AtlasText = {}

local FALLBACK = {
	chalk = { Color3.fromRGB(236, 236, 228), Enum.Font.PatrickHand },
	blood = { Color3.fromRGB(122, 8, 8), Enum.Font.Creepster },
	ink = { Color3.fromRGB(28, 34, 74), Enum.Font.PatrickHand },
	redink = { Color3.fromRGB(170, 14, 14), Enum.Font.PatrickHand },
	brush = { Color3.fromRGB(20, 18, 16), Enum.Font.PatrickHand },
}

-- 아틀라스 N 번 그림의 이미지 ID (Config 값 → 서버가 데칼에서 찾아 둔 값 순서)
local function imageId(n)
	local ids = Config.TEXT_ATLAS_IDS or {}
	if ids[n] and ids[n] ~= 0 then
		return ids[n]
	end
	return script.Parent:GetAttribute("TextAtlasImage" .. n)
end

-- 서버 전용: 올려 둔 데칼을 열어 진짜 이미지 ID 를 찾아 ReplicatedStorage 속성에 적는다 (클라이언트도 읽음)
function AtlasText.Resolve()
	if not RunService:IsServer() then
		return
	end
	local InsertService = game:GetService("InsertService")
	for n, did in ipairs(Config.TEXT_ATLAS_DECAL_IDS or {}) do
		local cfgId = (Config.TEXT_ATLAS_IDS or {})[n]
		if (not cfgId or cfgId == 0) and did and did ~= 0 and not script.Parent:GetAttribute("TextAtlasImage" .. n) then
			local ok, model = pcall(function()
				return InsertService:LoadAsset(did)
			end)
			if ok and model then
				local d = model:FindFirstChildWhichIsA("Decal", true)
				local id = d and tonumber(string.match(d.Texture, "(%d+)%s*$"))
				if id then
					script.Parent:SetAttribute("TextAtlasImage" .. n, id)
				end
				model:Destroy()
			else
				warn("[AtlasText] 데칼 " .. tostring(did) .. " 을(를) 열지 못했습니다. 게임을 내 계정으로 Publish 했는지 확인하세요. " .. tostring(model))
			end
		end
	end
end

function AtlasText.Entry(key)
	return Atlas.Entries[key]
end

-- 그림 한 칸의 가로/세로 비 (가로 ÷ 세로)
function AtlasText.Aspect(key)
	local e = Atlas.Entries[key]
	return e and e.w / e.h or 4
end

function AtlasText.HasImages()
	for i = 1, Atlas.Count do
		if not imageId(i) then
			return false
		end
	end
	return true
end

-- parent 를 가득 채우는 글자 GUI 를 만든다. 반환: ImageLabel 또는 TextLabel
function AtlasText.Make(key, parent, zIndex)
	local e = Atlas.Entries[key]
	local id = e and imageId(e.atlas)
	local g
	if e and id then
		g = Instance.new("ImageLabel")
		g.Image = "rbxassetid://" .. id
		g.ImageRectOffset = Vector2.new(e.x, e.y)
		g.ImageRectSize = Vector2.new(e.w, e.h)
		g.ScaleType = Enum.ScaleType.Stretch
	else
		g = Instance.new("TextLabel")
		local f = FALLBACK[e and e.style or "ink"] or FALLBACK.ink
		g.Text = e and e.text or key
		g.TextColor3 = f[1]
		g.Font = f[2]
		g.TextScaled = true
		g.TextXAlignment = Enum.TextXAlignment.Left
		-- 이미지 ID 를 나중에 알게 되면 (서버가 데칼을 다 연 뒤) 그림으로 바꾼다
		if e then
			local conn
			conn = script.Parent:GetAttributeChangedSignal("TextAtlasImage" .. e.atlas):Connect(function()
				if g.Parent and imageId(e.atlas) then
					conn:Disconnect()
					local p, z = g.Parent, g.ZIndex
					g:Destroy()
					AtlasText.Make(key, p, z)
				end
			end)
		end
	end
	g.Name = "Writing"
	g.BackgroundTransparency = 1
	g.BorderSizePixel = 0
	g.Size = UDim2.fromScale(1, 1)
	if zIndex then
		g.ZIndex = zIndex
	end
	g:SetAttribute("AtlasKey", key)
	g.Parent = parent
	return g
end

return AtlasText
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX00000004">
			<Properties>
				<string name="Name">Config</string>
				<ProtectedString name="Source"><![CDATA[-- 싸이 뛰어! 나폴리탄 괴담: 송천고 야간 경비 — 설정
-- 숫자만 바꾸면 되는 것들을 모아 둔 곳

local Config = {}

-- ───────── 공유 스킨 (무료) ─────────
-- roblox/clothes/guard_shirt.png, guard_pants.png 를 Studio에서 업로드(무료)한 뒤
-- 나온 "이미지 ID" 숫자를 넣으세요. 0이면 옷 대신 몸 색깔로 남색 유니폼을 흉내 냅니다.
Config.SHIRT_IMAGE_ID = 0
Config.PANTS_IMAGE_ID = 0
-- (선택) 마켓의 무료 머리·얼굴 아이템 ID. 0이면 플레이어 원래 머리 대신 기본 짧은 머리 모양 파츠를 씌움
Config.HAIR_ACCESSORY_ID = 0
Config.FACE_ID = 0
Config.SKIN_COLOR = Color3.fromRGB(234, 196, 160)
Config.HERO_NAME = "공유"

-- ───────── 움직임 (1인칭) ─────────
Config.WALK_SPEED = 9
Config.SPRINT_SPEED = 15
Config.STAMINA_SECONDS = 6
Config.FIELD_OF_VIEW = 72

-- ───────── 시간 ─────────
Config.SECONDS_PER_GAME_HOUR = 75 -- 22:00~06:00 = 8시간 = 10분
Config.SHIFT_START_HOUR = 22
Config.SHIFT_HOURS = 8

-- ───────── 이상현상 ─────────
Config.ANOMALY_MIN_GAP = 22
Config.ANOMALY_MAX_GAP = 40
Config.MAX_ACTIVE_ANOMALIES = 2
Config.FIRST_ANOMALY_DELAY = 20

-- ───────── 정신력 ─────────
Config.START_SANITY = 100
Config.PATROL_MISS_PENALTY = 15

-- ───────── 소리 (선택) ─────────
-- Creator Store에서 쓸 수 있는 사운드 ID를 넣으면 재생됩니다. 0이면 자막만 나와요.
-- ───────── 손글씨 그림 글자 (분필·피·수첩) ─────────
-- roblox/text_atlas/atlas_1.png ~ atlas_4.png 를 Studio → Asset Manager → Images → Import 로 올리고,
-- 각 그림의 이미지 ID 를 순서대로 넣는다. 0 이면 손글씨 대신 기본 글꼴로 보인다.
Config.TEXT_ATLAS_IDS = { 0, 0, 0, 0 }
-- 이미 올려 둔 데칼 ID (aied0 계정). 게임이 시작할 때 서버가 InsertService 로 열어 진짜 이미지 ID 를 찾는다.
-- 위 TEXT_ATLAS_IDS 에 이미지 ID 를 직접 넣으면 그쪽이 먼저 쓰인다.
Config.TEXT_ATLAS_DECAL_IDS = { 75904825982096, 116811792359111, 116869249478191, 77362890761808 }

-- ───────── 메시 팩 (나무·여학생·책걸상) ─────────
-- assets/SongcheonAssets.glb 를 올려 둔 모델 ID (aied0 계정). 게임이 시작할 때 서버가 불러온다.
-- Studio 에서 직접 Import 3D 로 가져와 둔 SongcheonAssets 가 있으면 그쪽을 먼저 쓴다.
Config.MESH_PACK_ID = 105636198805596

Config.SOUNDS = {
	Ambience = 0, -- 밤 학교 배경음 (반복)
	PhoneRing = 0, -- 전화벨
	Knock = 0, -- 철문 두드리는 소리
	Bell = 0, -- 학교 종소리
	Whisper = 0, -- 속삭임
	Static = 0, -- 방송 잡음
	GateClose = 0, -- 철문 닫히는 소리
	Car = 0, -- 자동차 엔진
	Chalk = 0, -- 분필 긁는 소리
	DoorSlide = 0, -- 교실 미닫이문 드르륵
	Switch = 0, -- 전등 스위치 딸깍
	-- 전화 목소리 (직접 녹음하거나 만든 음성 파일을 올려서 ID를 넣으면 수화기에서 들린다. 0이면 자막만)
	PhoneVoiceVice1 = 0, -- 교감: "아, 공유 씨? 첫날이라 걱정돼서요. 순찰 잘 부탁해요."
	PhoneVoiceVice2 = 0, -- 교감: "혹시 4층에 불이 켜져 있어도 올라가지 마세요. 우리 학교는 3층까지예요."
	PhoneVoiceStranger = 0, -- ???: "공유 씨… 공유 씨 거기 있죠? 문 좀 열어 줘요. 추워요."
	PhoneBreath = 0, -- 수화기 너머 숨소리 (말 없는 몇 초)
}

-- ───────── 근무 수칙 (경비실 벽 종이와 같은 내용) ─────────
Config.RULES = {
	"근무는 22:00 ~ 06:00. 06시 전엔 절대 정문을 열지 마세요.",
	"매시 정각 전, 1층·2층·3층 순찰함에 체크하세요.",
	"전화가 오면 받으세요. 단, 당신 이름을 부르면 끊으세요.",
	"4층은 없습니다.",
	"운동장에 의자가 있으면 쳐다보지 마세요.",
	"시계탑이 거꾸로 가면 건물에 들어가지 마세요.",
	"복도의 학생에게 말을 걸지 마세요. 학생들은 모두 하교했습니다.",
	"동상이 자리에 없다면, 찾지 마세요.",
}
-- 가끔 수칙 종이에 몰래 나타나는 9번
Config.RULE_NINE = "9. 경비원은 한 명입니다. 경비실에 누가 앉아 있다면, 당신은 누구입니까?"

-- ───────── 인트로 (차 타고 학교로) ─────────
-- 자동차가 지나갈 길 (X, Z). 마지막 점이 주차 위치(IntroCar가 원래 놓인 자리)입니다.
Config.INTRO_PATH = {
	Vector3.new(-520, 0, 133),
	Vector3.new(-260, 0, 133),
	Vector3.new(-70, 0, 133),
	Vector3.new(-22, 0, 130),
	Vector3.new(-2, 0, 116),
	Vector3.new(0, 0, 98),
	Vector3.new(0, 0, 84),
	Vector3.new(12, 0, 78),
	Vector3.new(32, 0, 75),
	Vector3.new(40.5, 0, 69),
	Vector3.new(40.5, 0, 62),
}
Config.INTRO_SECONDS = 26
Config.INTRO_LINES = {
	{ 1.0, "11월 13일 금요일, 밤 9시 50분." },
	{ 5.0, "공유: 야간 경비 알바, 시급 3만 원… 이 정도면 꿀알바지." },
	{ 10.5, "공유: 송천고등학교. 여기구나." },
	{ 15.0, "철컥— 정문이 혼자 열렸다." },
	{ 21.0, "공유: …주차하고, 경비실부터 가 보자." },
}
Config.AFTER_INTRO_LINES = {
	{ 0.0, "끼이이익… 쾅." },
	{ 2.2, "공유: …방금 문, 누가 닫았지?" },
	{ 5.0, "책상 위에 '근무 수칙'이 붙어 있다. 꼭 읽어 보자." },
}

return Config
]]></ProtectedString>
