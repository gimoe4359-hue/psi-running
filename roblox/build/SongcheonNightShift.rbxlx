",1.458,0.1,0.1,38.8,1.945,-111.325,22.166,0,90,1382,6,0,2,3,0],[104,"Frame",2.602,0.1,0.1,38.8,2.67,-109.75,87.797,0,90,1382,6,0,2,3,0],[104,"Frame",2.729,0.12,0.12,38.8,1.97,-109.85,-61.557,0,-90,1382,6,0,2,3,0],[104,"Frame",1.414,0.1,0.1,38.8,2.02,-108.55,8.13,0,-90,1382,6,0,2,3,0],[104,"Frame",1.751,0.08,0.08,38.8,1.295,-107.775,-88.363,0,-90,1382,6,0,2,3,0],[104,"Frame",2.122,0.08,0.08,38.8,1.995,-107.675,-46.909,0,-90,1382,6,0,2,3,0],[104,"Stem",0.461,0.08,0.08,38.8,2.845,-111.1,-12.529,0,90,285,6,0,2,3,0],[104,"Handlebar",1.5,0.07,0.07,38.8,3.12,-111.25,0,0,0,285,6,0,2,3,0],[104,"Grip",0.35,0.12,0.12,38.088,3.12,-111.25,0,0,0,30,19,0,2,3,0],[104,"Grip",0.35,0.12,0.12,39.512,3.12,-111.25,0,0,0,30,19,0,2,3,0],[104,"SeatPost",0.412,0.07,0.07,38.8,2.92,-108.5,-14.036,0,90,1381,6,0,2,3,0],[104,"Saddle",0.44,0.15,0.75,38.8,3.195,-108.575,0,0,0,30,20,0,0,3,0],[104,"Chainring",0.06,0.65,0.65,38.98,1.32,-108.65,0,0,0,23,6,0,2,3,0],[104,"Pedal",1.166,0.06,0.06,38.8,1.32,-108.65,0,0,30.964,287,6,0,2,3,0],[104,"Fender",1.202,0.12,0.12,38.8,2.475,-106.9,-86.662,0,-90,291,6,0,2,3,0],[104,"Kickstand",1.407,0.05,0.05,39.05,0.735,-108.35,-23.443,-9.649,-68.867,285,6,0,2,3,0],[104,"Tire",0.498,0.16,0.16,44.1,2.335,-111.357,-77.143,0,-90,337,19,0,2,3,0],[104,"Tire",0.498,0.16,0.16,44.1,2.124,-110.919,-51.429,0,-90,337,19,0,2,3,0],[104,"Tire",0.498,0.16,0.16,44.1,1.744,-110.616,-25.714,0,-90,337,19,0,2,3,0],[104,"Tire",0.498,0.16,0.16,44.1,1.27,-110.508,0,0,-90,337,19,0,2,3,0],[104,"Tire",0.498,0.16,0.16,44.1,0.796,-110.616,25.714,0,-90,337,19,0,2,3,0],[104,"Tire",0.498,0.16,0.16,44.1,0.416,-110.919,51.429,0,-90,337,19,0,2,3,0],[104,"Tire",0.498,0.16,0.16,44.1,0.205,-111.357,77.143,0,-90,337,19,0,2,3,0],[104,"Tire",0.498,0.16,0.16,44.1,0.205,-111.843,-77.143,0,90,337,19,0,2,3,0],[104,"Tire",0.498,0.16,0.16,44.1,0.416,-112.281,-51.429,0,90,337,19,0,2,3,0],[104,"Tire",0.498,0.16,0.16,44.1,0.796,-112.584,-25.714,0,90,337,19,0,2,3,0]]]==]
