			transparency = 0,
			collide = false,
			shadow = true,
			tris = 7968,
		}, {
			mesh = "Ghost_Vest",
			name = "Ghost_Vest",
			size = { 1.0609, 1.22, 0.6801 },
			pos = { 0.0011, 4.05, 0.0139 },
			color = { 32, 36, 54 },
			material = "Fabric",
			reflectance = 0,
			transparency = 0,
			collide = false,
			shadow = true,
			tris = 8892,
		}, {
			mesh = "Ghost_Skirt",
			name = "Ghost_Skirt",
			size = { 1.3996, 1.12, 1.0212 },
			pos = { -0.0186, 3.08, 0.0246 },
			color = { 40, 42, 58 },
			material = "Fabric",
			reflectance = 0,
			transparency = 0,
			collide = false,
			shadow = true,
			tris = 8380,
		}, {
			mesh = "Ghost_Socks",
			name = "Ghost_Socks",
			size = { 0.6141, 1.3654, 0.2937 },
			pos = { 0, 0.8773, 0.0373 },
			color = { 232, 232, 228 },
			material = "Fabric",
			reflectance = 0,
			transparency = 0,
			collide = false,
			shadow = true,
			tris = 8336,
		}, {
			mesh = "Ghost_Shoes",
