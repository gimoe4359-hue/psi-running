			pos = { 0, 2.18, 7.2462 },
			color = { 168, 22, 26 },
			material = "Glass",
			reflectance = 0.3,
			transparency = 0,
			collide = false,
			shadow = true,
			tris = 216,
		}, {
			mesh = "Sedan_Tires",
			name = "Tires",
			size = { 5.6831, 2.046, 10.7105 },
			pos = { 0, 1.023, -0.1762 },
			color = { 26, 26, 28 },
			material = "Rubber",
			reflectance = 0,
			transparency = 0,
			collide = false,
			shadow = true,
			tris = 4032,
		}, {
			mesh = "Sedan_Wheels",
			name = "Wheels",
			size = { 5.6831, 1.635, 10.2995 },
			pos = { 0, 1.023, -0.1762 },
			color = { 176, 180, 186 },
			material = "Metal",
			reflectance = 0.25,
			transparency = 0,
			collide = false,
			shadow = true,
			tris = 2464,
		}, {
			mesh = "Sedan_WheelDark",
			name = "WheelDark",
			size = { 5.59, 2.446, 10.5013 },
			pos = { 0, 1.023, 0.1284 },
			color = { 16, 16, 18 },
			material = "SmoothPlastic",
			reflectance = 0,
			transparency = 0,
			collide = false,
			shadow = false,
			tris = 624,
		} },
	},
}
]]></ProtectedString>
