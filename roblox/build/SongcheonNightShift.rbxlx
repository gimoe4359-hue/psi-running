end)
hud.Visible = true
hint.Visible = not UserInputService.TouchEnabled -- 키보드 안내는 컴퓨터에서만
task.delay(25, function()
	tween(hint, 2, { TextTransparency = 1 })
end)
mobile.Visible = UserInputService.TouchEnabled
