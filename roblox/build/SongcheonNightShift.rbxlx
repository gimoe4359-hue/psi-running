		<Item class="ModuleScript" referent="RBX00000005">
			<Properties>
				<string name="Name">TextAtlas</string>
				<ProtectedString name="Source"><![CDATA[-- 자동 생성 (tools/make_atlas.js). 손글씨 글자 아틀라스의 칸 정보.
-- 그림 파일: roblox/text_atlas/atlas_N.png → Studio에서 올린 뒤 Config.TEXT_ATLAS_IDS[N] 에 이미지 ID를 넣는다.
local A = {}
A.Size = 1024
A.Count = 4
A.Entries = {
	["openme"] = { atlas = 1, x = 6, y = 6, w = 423, h = 340, text = "열어줘", style = "blood" },
	["godown"] = { atlas = 1, x = 435, y = 6, w = 433, h = 319, text = "내려가", style = "blood" },
	["stay"] = { atlas = 1, x = 6, y = 352, w = 643, h = 273, text = "너도 남아", style = "blood" },
	["whoareyou"] = { atlas = 1, x = 6, y = 631, w = 674, h = 272, text = "누구세요?", style = "blood" },
	["fourth"] = { atlas = 2, x = 6, y = 6, w = 770, h = 263, text = "4층은 없습니다", style = "blood" },
	["playwithme"] = { atlas = 2, x = 6, y = 275, w = 636, h = 219, text = "같이 놀자♡", style = "blood" },
	["dontlook"] = { atlas = 2, x = 6, y = 500, w = 799, h = 149, text = "뒤를 돌아보지 마", style = "chalk" },
	["motto"] = { atlas = 2, x = 6, y = 655, w = 824, h = 124, text = "늦게까지 남지 말자", style = "brush" },
	["self"] = { atlas = 2, x = 6, y = 785, w = 193, h = 114, text = "자습", style = "chalk" },
	["date"] = { atlas = 2, x = 205, y = 785, w = 441, h = 105, text = "11월 13일 (금)", style = "chalk" },
	["mottoTitle"] = { atlas = 2, x = 652, y = 785, w = 147, h = 100, text = "급훈", style = "brush" },
	["note3"] = { atlas = 2, x = 6, y = 905, w = 489, h = 98, text = "청소 당번 1분단", style = "chalk" },
	["note1"] = { atlas = 2, x = 501, y = 905, w = 496, h = 96, text = "기말고사 D-18", style = "chalk" },
	["note4"] = { atlas = 3, x = 6, y = 6, w = 541, h = 96, text = "떠들면 이름 적음", style = "chalk" },
	["note2"] = { atlas = 3, x = 6, y = 108, w = 567, h = 95, text = "수행평가 제출 (월)", style = "chalk" },
	["note5"] = { atlas = 3, x = 6, y = 209, w = 593, h = 93, text = "숙제 수학익힘 84쪽", style = "chalk" },
	["duty2"] = { atlas = 3, x = 6, y = 308, w = 642, h = 90, text = "주번  박하은 · 최도윤", style = "chalk" },
	["duty3"] = { atlas = 3, x = 6, y = 404, w = 623, h = 89, text = "주번  정수아 · 강지호", style = "chalk" },
	["duty1"] = { atlas = 3, x = 6, y = 499, w = 606, h = 87, text = "주번  김민지 · 이서준", style = "chalk" },
	["rule_1_1"] = { atlas = 3, x = 6, y = 592, w = 538, h = 84, text = "야간 경비 근무 수칙", style = "ink" },
	["rule_1_4"] = { atlas = 3, x = 6, y = 682, w = 498, h = 71, text = "06시 전엔 절대 정문을", style = "ink" },
	["rule_1_6"] = { atlas = 3, x = 510, y = 682, w = 503, h = 71, text = "2. 매시 정각 전, 1·2·3층", style = "ink" },
	["rule_1_9"] = { atlas = 3, x = 6, y = 759, w = 506, h = 70, text = "단, 당신 이름을 부르면", style = "ink" },
	["rule_2_1"] = { atlas = 3, x = 6, y = 835, w = 585, h = 70, text = "5. 운동장에 의자가 있으면", style = "ink" },
	["rule_2_5"] = { atlas = 3, x = 597, y = 835, w = 414, h = 70, text = "7. 복도의 학생에게", style = "ink" },
	["rule_1_7"] = { atlas = 3, x = 6, y = 911, w = 488, h = 69, text = "순찰함에 체크하세요.", style = "ink" },
	["rule_1_8"] = { atlas = 4, x = 6, y = 6, w = 556, h = 69, text = "3. 전화가 오면 받으세요.", style = "ink" },
	["rule_2_8"] = { atlas = 4, x = 6, y = 81, w = 540, h = 69, text = "8. 동상이 자리에 없다면,", style = "ink" },
	["rule_2_7"] = { atlas = 4, x = 6, y = 156, w = 663, h = 68, text = "학생들은 모두 하교했습니다.", style = "ink" },
	["rule_1_5"] = { atlas = 4, x = 675, y = 156, w = 276, h = 67, text = "열지 마세요.", style = "ink" },
	["rule_1_10"] = { atlas = 4, x = 6, y = 230, w = 217, h = 67, text = "끊으세요.", style = "ink" },
	["rule_1_11"] = { atlas = 4, x = 229, y = 230, w = 425, h = 67, text = "4. 4층은 없습니다.", style = "ink" },
	["rule_2_2"] = { atlas = 4, x = 6, y = 303, w = 378, h = 67, text = "쳐다보지 마세요.", style = "ink" },
	["rule_2_4"] = { atlas = 4, x = 390, y = 303, w = 534, h = 67, text = "건물에 들어가지 마세요.", style = "ink" },
	["rule_2_6"] = { atlas = 4, x = 6, y = 376, w = 393, h = 67, text = "말을 걸지 마세요.", style = "ink" },
	["rule_2_9"] = { atlas = 4, x = 405, y = 376, w = 279, h = 67, text = "찾지 마세요.", style = "ink" },
	["rule_2_11"] = { atlas = 4, x = 6, y = 449, w = 670, h = 67, text = "9. 경비원은 한 명입니다.", style = "redink" },
	["rule_2_12"] = { atlas = 4, x = 6, y = 522, w = 746, h = 67, text = "경비실에 누가 앉아 있다면,", style = "redink" },
	["rule_2_13"] = { atlas = 4, x = 6, y = 595, w = 539, h = 67, text = "당신은 누구입니까?", style = "redink" },
	["rule_2_3"] = { atlas = 4, x = 6, y = 668, w = 519, h = 65, text = "6. 시계탑이 거꾸로 가면", style = "ink" },
	["rule_1_3"] = { atlas = 4, x = 6, y = 739, w = 595, h = 63, text = "1. 근무는 22:00 ~ 06:00.", style = "ink" },
}
A.Notebook = {
	{
