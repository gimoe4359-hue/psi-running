			color = { 26, 26, 28 },
			material = "Rubber",
			reflectance = 0,
			transparency = 0,
			collide = false,
			shadow = true,
			tris = 4032,
		}, {
			mesh = "SUV_Wheels",
			name = "Wheels",
			size = { 5.8158, 1.5838, 9.9538 },
			pos = { 0, 1.1392, -0.192 },
			color = { 176, 180, 186 },
			material = "Metal",
			reflectance = 0.25,
			transparency = 0,
			collide = false,
			shadow = true,
			tris = 2464,
		}, {
			mesh = "SUV_WheelDark",
			name = "WheelDark",
			size = { 5.74, 2.7985, 10.3958 },
			pos = { 0, 1.1393, 0.1943 },
			color = { 16, 16, 18 },
			material = "SmoothPlastic",
			reflectance = 0,
			transparency = 0,
			collide = false,
			shadow = false,
			tris = 624,
		} },
	},
}
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="ModuleScript" referent="RBX0000000B">
			<Properties>
				<string name="Name">GuardOutfit</string>
				<ProtectedString name="Source"><![CDATA[-- 경비원 공유 스킨 (무료)
-- 게임에 들어온 플레이어(= 공유가 당근에서 구한 대타 경비원)를 남색 경비복 + 경비 모자 + 이름표 차림으로 바꿉니다.
-- 이름표에는 각자 자기 이름이 들어갑니다.
-- 옷 이미지는 roblox/clothes/*.png 를 Studio에서 무료 업로드한 뒤 Config에 ID를 넣으면 적용됩니다.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))

local GuardOutfit = {}

local NAVY = Color3.fromRGB(36, 46, 74)
local NAVY_DARK = Color3.fromRGB(30, 36, 52)
local BLACK = Color3.fromRGB(16, 16, 18)
local GOLD = Color3.fromRGB(222, 184, 74)

local function weldPart(parent, attachTo, name, size, offset, color, mat, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	if shape then
		p.Shape = shape
	end
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = attachTo.CFrame * offset
	local w = Instance.new("WeldConstraint")
	w.Part0 = attachTo
	w.Part1 = p
	w.Parent = p
	p.Parent = parent
	return p
end

local function applyDescription(humanoid)
	local ok, desc = pcall(function()
		return humanoid:GetAppliedDescription()
	end)
	if not ok or not desc then
		return
	end
	desc.Shirt = 0
	desc.Pants = 0
	desc.GraphicTShirt = 0
	-- 몸은 기본 R15 몸으로 (특수 번들·애니메이션 얼굴이면 경비복이 어긋나므로). 플레이어 = 공유
	desc.Head = 0
	desc.Torso = 0
	desc.LeftArm = 0
	desc.RightArm = 0
	desc.LeftLeg = 0
	desc.RightLeg = 0
	desc.HeightScale = 1
	desc.WidthScale = 1
	desc.DepthScale = 1
	desc.HeadScale = 1
	desc.BodyTypeScale = 0
	desc.ProportionScale = 0
	pcall(function()
		desc:SetAccessories({}, true) -- 모자·가방 등 전부 벗기기
	end)
	desc.HatAccessory = ""
	desc.FaceAccessory = ""
	desc.BackAccessory = ""
	desc.FrontAccessory = ""
	desc.NeckAccessory = ""
	desc.ShouldersAccessory = ""
	desc.WaistAccessory = ""
	desc.HairAccessory = Config.HAIR_ACCESSORY_ID ~= 0 and tostring(Config.HAIR_ACCESSORY_ID) or ""
	if Config.FACE_ID ~= 0 then
		desc.Face = Config.FACE_ID
	end
	local skin = Config.SKIN_COLOR
	desc.HeadColor = skin
	if Config.SHIRT_IMAGE_ID ~= 0 then
		desc.TorsoColor = skin
		desc.LeftArmColor = skin
		desc.RightArmColor = skin
	else
		-- 옷 이미지가 없으면 몸 색으로 유니폼 흉내
		desc.TorsoColor = NAVY
		desc.LeftArmColor = NAVY
		desc.RightArmColor = NAVY
	end
	desc.LeftLegColor = NAVY_DARK
	desc.RightLegColor = NAVY_DARK
	pcall(function()
		humanoid:ApplyDescription(desc)
	end)
end

function GuardOutfit.Apply(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local head = character:WaitForChild("Head", 10)
	if not humanoid or not head then
		return
	end
	if player:HasAppearanceLoaded() == false then
		player.CharacterAppearanceLoaded:Wait()
	end
	if character.Parent == nil then
		return
	end
	applyDescription(humanoid)
	head = character:FindFirstChild("Head") or head

	-- 셔츠·바지 (업로드한 이미지 ID)
	for _, c in ipairs(character:GetChildren()) do
		if c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic") then
			c:Destroy()
		end
	end
	if Config.SHIRT_IMAGE_ID ~= 0 then
		local s = Instance.new("Shirt")
		s.ShirtTemplate = "rbxassetid://" .. Config.SHIRT_IMAGE_ID
		s.Parent = character
	end
	if Config.PANTS_IMAGE_ID ~= 0 then
		local p = Instance.new("Pants")
		p.PantsTemplate = "rbxassetid://" .. Config.PANTS_IMAGE_ID
		p.Parent = character
	end

	humanoid.DisplayName = "경비원 " .. player.DisplayName -- 공유가 구한 대타: 이름표는 각자 자기 이름
	humanoid.NameDisplayDistance = 30

	local outfit = character:FindFirstChild("GuardOutfit")
	if outfit then
		outfit:Destroy()
	end
	outfit = Instance.new("Folder")
	outfit.Name = "GuardOutfit"
	outfit.Parent = character

	local hs = head.Size
	-- 짧은 검은 머리 (무료 머리 아이템을 안 쓸 때)
	if Config.HAIR_ACCESSORY_ID == 0 then
		weldPart(outfit, head, "Hair", Vector3.new(hs.X * 1.06, hs.Y * 0.32, hs.Z * 1.06), CFrame.new(0, hs.Y * 0.36, hs.Z * 0.04), Color3.fromRGB(26, 20, 16), Enum.Material.SmoothPlastic)
		weldPart(outfit, head, "HairBack", Vector3.new(hs.X * 1.06, hs.Y * 0.5, hs.Z * 0.2), CFrame.new(0, hs.Y * 0.12, hs.Z * 0.47), Color3.fromRGB(26, 20, 16), Enum.Material.SmoothPlastic)
	end
	-- 경비 모자
	local crownD = hs.X * 1.2
	weldPart(outfit, head, "CapCrown", Vector3.new(hs.Y * 0.42, crownD, crownD), CFrame.new(0, hs.Y * 0.62, 0) * CFrame.Angles(0, 0, math.rad(90)), NAVY, Enum.Material.Fabric, Enum.PartType.Cylinder)
	weldPart(outfit, head, "CapBand", Vector3.new(hs.Y * 0.14, crownD * 0.94, crownD * 0.94), CFrame.new(0, hs.Y * 0.42, 0) * CFrame.Angles(0, 0, math.rad(90)), BLACK, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
	weldPart(outfit, head, "CapVisor", Vector3.new(hs.X * 0.95, 0.08, hs.Z * 0.5), CFrame.new(0, hs.Y * 0.4, -hs.Z * 0.66) * CFrame.Angles(math.rad(-12), 0, 0), BLACK, Enum.Material.SmoothPlastic)
	weldPart(outfit, head, "CapBadge", Vector3.new(hs.X * 0.24, hs.Y * 0.24, 0.06), CFrame.new(0, hs.Y * 0.66, -crownD * 0.5), GOLD, Enum.Material.Metal)

	-- 가슴 이름표(플레이어 이름) + 왼팔 경비 표지
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if torso then
		local ts = torso.Size
		local tag = weldPart(outfit, torso, "NameTag", Vector3.new(ts.X * 0.3, ts.Y * 0.12, 0.05), CFrame.new(ts.X * 0.24, ts.Y * 0.22, -ts.Z / 2 - 0.03), Color3.fromRGB(240, 240, 236), Enum.Material.SmoothPlastic)
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 120
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = player.DisplayName
		label.TextScaled = true
		label.Font = Enum.Font.BuilderSansBold
		label.TextColor3 = Color3.fromRGB(20, 24, 40)
		label.Parent = gui
		gui.Parent = tag
		weldPart(outfit, torso, "ChestBadge", Vector3.new(ts.X * 0.16, ts.Y * 0.16, 0.05), CFrame.new(-ts.X * 0.24, ts.Y * 0.22, -ts.Z / 2 - 0.03), GOLD, Enum.Material.Metal)
	end
	local arm = character:FindFirstChild("LeftUpperArm") or character:FindFirstChild("Left Arm")
	if arm then
		local as = arm.Size
		weldPart(outfit, arm, "ArmPatch", Vector3.new(as.X * 1.04, as.Y * (arm.Name == "Left Arm" and 0.14 or 0.3), as.Z * 1.04), CFrame.new(0, as.Y * (arm.Name == "Left Arm" and 0.3 or 0.1), 0), Color3.fromRGB(214, 176, 60), Enum.Material.Fabric)
	end

	-- 손전등 (오른손에 들고 있음. 빛은 각자 화면에서 켜짐 → Client 스크립트)
	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if hand then
		local downOffset = hand.Name == "Right Arm" and -hand.Size.Y * 0.45 or -hand.Size.Y * 0.2
		local body = weldPart(outfit, hand, "Flashlight", Vector3.new(1.1, 0.34, 0.34), CFrame.new(0, downOffset, -0.45) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(34, 34, 36), Enum.Material.Metal, Enum.PartType.Cylinder)
		weldPart(outfit, body, "Lens", Vector3.new(0.08, 0.36, 0.36), CFrame.new(0.56, 0, 0), Color3.fromRGB(255, 246, 216), Enum.Material.Neon, Enum.PartType.Cylinder)
	end
end

return GuardOutfit
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX0000000C">
			<Properties>
				<string name="Name">Main</string>
				<ProtectedString name="Source"><![CDATA[-- 싸이 뛰어! 나폴리탄 괴담: 송천고 야간 경비 — 서버 메인
-- 맵을 짓고, 근무 시간(22:00~06:00)·순찰·정신력·엔딩을 관리합니다.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))

-- 맵을 다 지을 때까지 캐릭터를 만들지 않음 (허공으로 떨어지지 않게)
Players.CharacterAutoLoads = false

-- ───────── 리모트 ─────────
local remotes = Instance.new("Folder")
remotes.Name = "NightShiftRemotes"
local function remote(name)
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
	return r
end
local Subtitle = remote("Subtitle") -- (글, 초, 색이름)
local IntroFinished = remote("IntroFinished")
local ChairGaze = remote("ChairGaze")
local Effect = remote("Effect") -- (종류)
local Ending = remote("Ending") -- (종류)
local FlashToggle = remote("Flashlight") -- (켜짐 여부) 다른 사람도 내 손전등 불빛을 본다
remotes.Parent = ReplicatedStorage

-- ───────── 맵 ─────────
-- 손글씨 그림 ID 를 먼저 찾아 둔다 (올려 둔 데칼 → 이미지)
pcall(function()
	require(game:GetService("ReplicatedStorage"):WaitForChild("AtlasText")).Resolve()
end)
local Builder = require(ServerScriptService:WaitForChild("SchoolBuilder"))
local school = Builder.Build(workspace, true)
-- 벽·바닥·천장에 실사 텍스처를 붙인다 (데칼 이미지를 못 불러오면 기본 재질 그대로)
task.spawn(function()
	local ok, err = pcall(function()
		require(ServerScriptService:WaitForChild("SurfaceTextures")).Apply(school)
		require(ServerScriptService:WaitForChild("SurfaceTextures")).ApplyLeaves(school)
	end)
	if not ok then
		warn("[SurfaceTextures] " .. tostring(err))
	end
end)
workspace:SetAttribute("MapReady", true)

local function tagged(tag)
	return CollectionService:GetTagged(tag)
end
local function first(tag)
	return tagged(tag)[1]
end

-- ───────── 밤 분위기 ─────────
-- 정전된 듯 불 꺼진 학교: 손전등 없이는 거의 안 보일 만큼 어둡게
Lighting.ClockTime = 22
Lighting.Brightness = 0.55
Lighting.Ambient = Color3.fromRGB(3, 4, 6)
Lighting.OutdoorAmbient = Color3.fromRGB(16, 18, 28)
Lighting.EnvironmentDiffuseScale = 1
Lighting.EnvironmentSpecularScale = 1
Lighting.GlobalShadows = true
Lighting.ShadowSoftness = 0.25
Lighting.ExposureCompensation = -0.25
Lighting.GeographicLatitude = 37.5 -- 서울
pcall(function()
	Lighting.Technology = Enum.Technology.Future -- Studio에서만 바뀌는 경우가 있음. 안 되면 직접 Future로
end)
local function effect(class, props)
	local e = Lighting:FindFirstChildOfClass(class) or Instance.new(class)
	for k, v in pairs(props) do
		e[k] = v
	end
	e.Parent = Lighting
	return e
end
effect("Atmosphere", { Density = 0.45, Offset = 0.02, Color = Color3.fromRGB(44, 50, 66), Decay = Color3.fromRGB(10, 11, 18), Glare = 0, Haze = 2.2 })
effect("ColorCorrectionEffect", { Brightness = -0.02, Contrast = 0.24, Saturation = -0.38, TintColor = Color3.fromRGB(206, 218, 236) })
effect("BloomEffect", { Intensity = 0.45, Size = 26, Threshold = 1.3 })
effect("SunRaysEffect", { Intensity = 0, Spread = 0.5 })
local sky = Lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky")
sky.StarCount = 900
sky.MoonAngularSize = 9
sky.CelestialBodiesShown = true
sky.Parent = Lighting

local function playSound(name, parent, looped)
	local id = Config.SOUNDS[name]
	if not id or id == 0 then
		return nil
	end
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://" .. id
	s.Looped = looped or false
	s.RollOffMaxDistance = 200
	s.Parent = parent or workspace
	s:Play()
	if not looped then
		s.Ended:Connect(function()
			s:Destroy()
		end)
	end
	return s
end
playSound("Ambience", workspace, true)

-- ───────── 공통 도구 ─────────
local api = {}
api.Subtitle = Subtitle
api.Effect = Effect
api.playSound = playSound
api.school = school

local function rootOf(player)
	local ch = player.Character
	return ch and ch:FindFirstChild("HumanoidRootPart")
end
api.rootOf = rootOf

function api.inside(part, pos)
	local rel = part.CFrame:PointToObjectSpace(pos)
	local h = part.Size / 2
	return math.abs(rel.X) <= h.X and math.abs(rel.Y) <= h.Y and math.abs(rel.Z) <= h.Z
end

function api.activePlayers()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p:GetAttribute("IntroDone") and not p:GetAttribute("Ended") then
			local ch = p.Character
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 and rootOf(p) then
				table.insert(list, p)
			end
		end
	end
	return list
end

function api.say(player, text, seconds, color)
	Subtitle:FireClient(player, text, seconds or 4, color or "white")
end
function api.sayAll(text, seconds, color)
	for _, p in ipairs(api.activePlayers()) do
		api.say(p, text, seconds, color)
	end
end
function api.sayNear(pos, radius, text, seconds, color)
	for _, p in ipairs(api.activePlayers()) do
		local r = rootOf(p)
		if r and (r.Position - pos).Magnitude <= radius then
			api.say(p, text, seconds, color)
		end
	end
end

function api.teleportToBooth(player)
	local spawnPart = first("BoothSpawn")
	local r = rootOf(player)
	if spawnPart and r then
		player.Character:PivotTo(CFrame.new(spawnPart.Position + Vector3.new(0, 3.5, 0)) * CFrame.Angles(0, math.rad(180), 0))
	end
end

local endFor -- 아래에서 정의

function api.addSanity(player, delta, reason)
	if not player:GetAttribute("IntroDone") or player:GetAttribute("Ended") then
		return
	end
	local s = math.clamp((player:GetAttribute("Sanity") or Config.START_SANITY) + delta, 0, 100)
	player:SetAttribute("Sanity", s)
	if reason then
		api.say(player, reason, 4, delta < 0 and "red" or "green")
	end
	if delta < 0 then
		Effect:FireClient(player, "hurt")
	end
	if s <= 0 then
		endFor(player, "SANITY")
	end
end

-- ───────── 근무 시간 ─────────
local shift = { running = false, minutes = 0, lastHour = 0 }
workspace:SetAttribute("ShiftMinutes", 0)
workspace:SetAttribute("ShiftRunning", false)

function api.hour()
	return math.floor(shift.minutes / 60) -- 0 = 22시대, 7 = 05시대
end
function api.shiftRunning()
	return shift.running
end

local function resetPatrol(player)
	for f = 1, 3 do
		player:SetAttribute("Patrol" .. f, false)
	end
end

function endFor(player, kind)
	if player:GetAttribute("Ended") then
		return
	end
	player:SetAttribute("Ended", true)
	Ending:FireClient(player, kind)
	if kind ~= "CLEAR" then
		task.delay(9, function()
			if player.Parent then
				player:SetAttribute("Sanity", Config.START_SANITY)
				player:SetAttribute("Ended", false)
				resetPatrol(player)
				player:LoadCharacter()
			end
		end)
	end
end
api.endFor = endFor

local Anomalies = require(ServerScriptService:WaitForChild("Anomalies"))

local function startShift()
	if shift.running then
		return
	end
	shift.running = true
	shift.minutes = 0
	shift.lastHour = 0
	workspace:SetAttribute("ShiftRunning", true)
	for _, p in ipairs(Players:GetPlayers()) do
		resetPatrol(p)
	end
	Anomalies.Start(api)
end

local function finishShift()
	shift.running = false
	workspace:SetAttribute("ShiftRunning", false)
	Anomalies.StopAll()
	for _, p in ipairs(api.activePlayers()) do
		endFor(p, "CLEAR")
	end
	-- 20초 뒤 새 밤 시작 (다시 하기)
	task.delay(20, function()
		for _, p in ipairs(Players:GetPlayers()) do
			p:SetAttribute("Ended", false)
			p:SetAttribute("Sanity", Config.START_SANITY)
			resetPatrol(p)
			if p:GetAttribute("IntroDone") then
				p:LoadCharacter()
			end
		end
		shift.minutes = 0
		workspace:SetAttribute("ShiftMinutes", 0)
		if #Players:GetPlayers() > 0 then
			startShift()
		end
	end)
end

local function onHourPassed(h)
	-- 정각: 순찰 확인
	for _, p in ipairs(api.activePlayers()) do
		local done = 0
		for f = 1, 3 do
			if p:GetAttribute("Patrol" .. f) then
				done = done + 1
			end
		end
		if done < 3 then
			api.addSanity(p, -Config.PATROL_MISS_PENALTY, string.format("순찰을 다 돌지 못했다 (%d/3). 어딘가에서 발소리가 따라온다…", done))
		else
			api.say(p, "순찰 완료. 무사히 한 시간을 넘겼다.", 3, "green")
		end
		resetPatrol(p)
	end
	local clockHour = (Config.SHIFT_START_HOUR + h) % 24
	if clockHour == 0 then
		api.sayAll("자정. 학교 종이 울렸다. …아무도 없는데.", 4)
		playSound("Bell", first("ClockCenter"))
	elseif clockHour == 3 then
		api.sayAll("새벽 3시. 이상하게 조용하다.", 4)
	end
end

-- ───────── 시계탑 ─────────
local clockCenter = first("ClockCenter")
local hourHand = first("ClockHour")
local minuteHand = first("ClockMinute")
local handZ = {}
if hourHand and minuteHand then
	handZ[hourHand] = hourHand.Position.Z
	handZ[minuteHand] = minuteHand.Position.Z
end
local backwardAngle = 0
local function setHand(hand, deg)
	local c = clockCenter.Position
	hand.CFrame = CFrame.new(c.X, c.Y, handZ[hand]) * CFrame.Angles(0, 0, -math.rad(deg)) * CFrame.new(0, hand.Size.Y / 2, 0)
end

-- ───────── 매 프레임 ─────────
RunService.Heartbeat:Connect(function(dt)
	if shift.running then
		shift.minutes = shift.minutes + dt * 60 / Config.SECONDS_PER_GAME_HOUR
		local h = math.floor(shift.minutes / 60)
		if h > shift.lastHour then
			shift.lastHour = h
			if h >= Config.SHIFT_HOURS then
				shift.minutes = Config.SHIFT_HOURS * 60
				finishShift()
			else
				onHourPassed(h)
			end
		end
		workspace:SetAttribute("ShiftMinutes", shift.minutes)
	end
	local hours = Config.SHIFT_START_HOUR + shift.minutes / 60
	Lighting.ClockTime = hours % 24
	if clockCenter and hourHand and minuteHand then
		if Anomalies.clockBackward then
			backwardAngle = backwardAngle - dt * 240
			setHand(minuteHand, backwardAngle)
			setHand(hourHand, backwardAngle / 12)
		else
			setHand(minuteHand, (shift.minutes % 60) / 60 * 360)
			setHand(hourHand, (hours % 12) / 12 * 360)
			backwardAngle = (shift.minutes % 60) / 60 * 360
		end
	end
end)

-- ───────── 늘 깜빡이는 조명 ─────────
task.spawn(function()
	while true do
		task.wait(math.random(15, 40) / 10)
		for _, part in ipairs(tagged("FlickerLight")) do
			if math.random() < 0.35 then
				local light = part:FindFirstChildWhichIsA("Light")
				task.spawn(function()
					for _ = 1, math.random(2, 5) do
						if light then
							light.Enabled = false
						end
						part.Material = Enum.Material.SmoothPlastic
						task.wait(math.random(3, 12) / 100)
						if light then
							light.Enabled = light:GetAttribute("Off") ~= true
						end
						if not (light and light:GetAttribute("Off")) then
							part.Material = Enum.Material.Neon
						end
						task.wait(math.random(3, 20) / 100)
					end
				end)
			end
		end
	end
end)
-- 꺼져 있는 등은 깜빡일 때 켜지지 않도록 표시
for _, part in ipairs(tagged("FlickerLight")) do
	local light = part:FindFirstChildWhichIsA("Light")
	if light and not light.Enabled then
		light:SetAttribute("Off", true)
	end
end

-- ───────── 교실 미닫이문 ─────────
-- 문짝(PrimaryPart "DoorLeaf")이 SlideX 만큼 옆으로 밀린다. "문 열기 / 문 닫기" 프롬프트.
local doors = {}
function api.slideDoor(door, wantOpen, seconds)
	local state = doors[door]
	if not state or state.busy then
		return false
	end
	if wantOpen == nil then
		wantOpen = not state.open
	end
	if wantOpen == state.open then
		return false
	end
	state.busy = true
	state.open = wantOpen
	state.prompt.ActionText = wantOpen and "문 닫기" or "문 열기"
	local v = Instance.new("CFrameValue")
	v.Value = door:GetPivot()
	v.Changed:Connect(function(cf)
		door:PivotTo(cf)
	end)
	local tw = TweenService:Create(v, TweenInfo.new(seconds or 0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Value = wantOpen and state.opened or state.closed,
	})
	tw:Play()
	playSound("DoorSlide", door.PrimaryPart)
	tw.Completed:Connect(function()
		v:Destroy()
		state.busy = false
	end)
	return true
end
function api.doorsNear(pos, radius)
	local list = {}
	for door in pairs(doors) do
		if door.Parent and (door:GetPivot().Position - pos).Magnitude < radius then
			table.insert(list, door)
		end
	end
	return list
end
local function setupDoor(door)
	local leaf = door:IsA("Model") and door.PrimaryPart
	if not leaf or doors[door] then
		return
	end
	local offset = Vector3.new(leaf:GetAttribute("SlideX") or 3.5, 0, 0)
	local state = { open = leaf:GetAttribute("Open") == true, busy = false }
	local pivot = door:GetPivot()
	state.closed = state.open and (pivot - offset) or pivot
	state.opened = state.closed + offset
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = state.open and "문 닫기" or "문 열기"
	prompt.ObjectText = "미닫이문"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 7
	prompt.RequiresLineOfSight = false
	prompt.Parent = leaf
	state.prompt = prompt
	doors[door] = state
	prompt.Triggered:Connect(function()
		api.slideDoor(door)
	end)
end
for _, door in ipairs(tagged("SlidingDoor")) do
	setupDoor(door)
end
CollectionService:GetInstanceAddedSignal("SlidingDoor"):Connect(setupDoor)

-- ───────── 여닫이문 (경비실 문, 현관 유리문, 비상구, 화장실 칸) ─────────
-- 모델의 PrimaryPart "DoorLeaf"(투명, 몸을 막음)에 경첩 위치(HX, HZ)와 여는 각도(Swing)가 적혀 있다.
-- Locked 속성이 있으면 열리지 않고 그 말만 나온다.
local hinges = {}
function api.swingDoor(door, wantOpen, seconds)
	local state = hinges[door]
	if not state or state.busy then
		return false
	end
	if wantOpen == nil then
		wantOpen = not state.open
	end
	if wantOpen == state.open then
		return false
	end
	state.busy = true
	state.open = wantOpen
	state.prompt.ActionText = wantOpen and "문 닫기" or "문 열기"
	local v = Instance.new("NumberValue")
	v.Value = wantOpen and 0 or 1
	v.Changed:Connect(function(t)
		door:PivotTo(state.at(t))
	end)
	local tw = TweenService:Create(v, TweenInfo.new(seconds or 0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = wantOpen and 1 or 0 })
	tw:Play()
	playSound("DoorSlide", door.PrimaryPart)
	tw.Completed:Connect(function()
		door:PivotTo(state.at(wantOpen and 1 or 0))
		v:Destroy()
		state.busy = false
	end)
	return true
end
local function setupHinge(door)
	local leaf = door:IsA("Model") and door.PrimaryPart
	if not leaf or hinges[door] then
		return
	end
	local closed = door:GetPivot()
	local hinge = CFrame.new(leaf:GetAttribute("HX") or leaf.Position.X, leaf.Position.Y, leaf:GetAttribute("HZ") or leaf.Position.Z)
	local swing = math.rad(leaf:GetAttribute("Swing") or 90)
	local locked = leaf:GetAttribute("Locked")
	local state = { open = false, busy = false }
	function state.at(t)
		return hinge * CFrame.Angles(0, swing * t, 0) * hinge:Inverse() * closed
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "문 열기"
	prompt.ObjectText = "문"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.Parent = leaf
	state.prompt = prompt
	hinges[door] = state
	if leaf:GetAttribute("Open") == true and not locked then
		state.open = true
		prompt.ActionText = "문 닫기"
		door:PivotTo(state.at(1))
	end
	prompt.Triggered:Connect(function(player)
		if locked then
			api.say(player, locked, 3)
			playSound("Knock", leaf)
			return
		end
		api.swingDoor(door)
	end)
end
for _, door in ipairs(tagged("HingeDoor")) do
	setupHinge(door)
end
CollectionService:GetInstanceAddedSignal("HingeDoor"):Connect(setupHinge)

-- 잠긴 문 (옥상 문, 화장실 세 번째 칸): 눌러 보면 잠겨 있다는 말이 나온다
local function setupLocked(part)
	if not part:IsA("BasePart") or part:FindFirstChild("LockPrompt") then
		return
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "LockPrompt"
	prompt.ActionText = "문 열기"
	prompt.ObjectText = "문"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 7
	prompt.RequiresLineOfSight = false
	prompt.Parent = part
	prompt.Triggered:Connect(function(player)
		if part.CanCollide then
			api.say(player, part:GetAttribute("Locked") or "잠겨 있다.", 3)
		end
	end)
end
for _, part in ipairs(tagged("LockedDoor")) do
	setupLocked(part)
end
CollectionService:GetInstanceAddedSignal("LockedDoor"):Connect(setupLocked)

-- ───────── 교실 전등 스위치 ─────────
-- 앞문 옆 스위치로 그 방의 형광등(Tube)과 조명을 켜고 끈다.
function api.setRoomLights(room, on)
	for _, d in ipairs(room:GetDescendants()) do
		if d:IsA("BasePart") and d.Name == "Tube" then
			d.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
			d.Color = on and Color3.fromRGB(246, 248, 255) or Color3.fromRGB(222, 224, 222)
		elseif d:IsA("Light") and d.Parent and (d.Parent.Name == "LampBody" or d.Parent.Name == "BoardLampBody" or d.Parent.Name == "LampFill") then
			-- 아래로 비추는 SurfaceLight + 천장·벽을 밝히는 약한 PointLight
			d.Enabled = on
			d.Brightness = on and (d:IsA("PointLight") and 0.5 or 1.2) or 0
		end
	end
	room:SetAttribute("LightsOn", on)
end
for _, plate in ipairs(tagged("RoomSwitch")) do
	local room = plate.Parent
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "스위치 누르기"
	prompt.ObjectText = "전등 스위치"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 6
	prompt.RequiresLineOfSight = false
	prompt.Parent = plate
	-- 정전: 스위치를 눌러도 불이 안 들어온다 (이상현상이 켠 불만 끌 수 있다)
	prompt.Triggered:Connect(function(player)
		playSound("Switch", plate)
		if room:GetAttribute("LightsOn") then
			api.setRoomLights(room, false)
			api.say(player, "딸깍. …누가 켜 놓은 거지?", 3)
		else
			api.say(player, "딸깍, 딸깍. …불이 안 들어온다. 손전등에 의지하자.", 3)
		end
	end)
end

-- ───────── 순찰함 ─────────
for _, box in ipairs(tagged("PatrolPoint")) do
	local floor = box:GetAttribute("Floor")
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "순찰 체크"
	prompt.ObjectText = "순찰함 " .. floor .. "F"
	prompt.HoldDuration = 0.6
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.Parent = box
	prompt.Triggered:Connect(function(player)
		if not shift.running or player:GetAttribute("Ended") then
			return
		end
		if player:GetAttribute("Patrol" .. floor) then
			api.say(player, floor .. "층은 이번 시간에 이미 체크했다.", 2.5)
			return
		end
		player:SetAttribute("Patrol" .. floor, true)
		local done = 0
		for f = 1, 3 do
			if player:GetAttribute("Patrol" .. f) then
				done = done + 1
			end
		end
		api.say(player, string.format("%dF 순찰 완료 (%d/3)", floor, done), 2.5, "green")
	end)
end

-- ───────── 정문 ─────────
local gateModel = school:FindFirstChild("MainGate", true)
local gateLock = first("GateLock")
local gateOpen = false
local function moveGate(open)
	if not gateModel or gateOpen == open then
		return
	end
	gateOpen = open
	local base = gateModel:GetAttribute("ClosedPivot")
	if not base then
		gateModel:SetAttribute("ClosedPivot", gateModel:GetPivot())
		base = gateModel:GetPivot()
	end
	local target = open and (base * CFrame.new(-28, 0, 0)) or base
	local v = Instance.new("CFrameValue")
	v.Value = gateModel:GetPivot()
	v.Changed:Connect(function(cf)
		gateModel:PivotTo(cf)
	end)
	local tw = TweenService:Create(v, TweenInfo.new(3, Enum.EasingStyle.Sine), { Value = target })
	tw:Play()
	tw.Completed:Connect(function()
		v:Destroy()
	end)
	playSound("GateClose", gateLock)
end
if gateModel then
	gateModel:SetAttribute("ClosedPivot", gateModel:GetPivot())
end
if gateLock then
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "정문 열기"
	prompt.ObjectText = "정문"
	prompt.HoldDuration = 1.5
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = gateLock
	prompt.Triggered:Connect(function(player)
		if shift.running and shift.minutes < Config.SHIFT_HOURS * 60 then
			-- 수칙 1번 위반
			moveGate(true)
			Effect:FireClient(player, "jumpscare")
			endFor(player, "GATE")
			task.delay(6, function()
				moveGate(false)
			end)
		else
			moveGate(true)
			api.say(player, "아침 공기가 들어온다. …살았다.", 4, "green")
			task.delay(12, function()
				moveGate(false)
			end)
		end
	end)
end

-- ───────── 로비 · 출근 차량 (SUV) ─────────
-- 처음 들어온 사람은 편의점 앞(로비)에서 시작한다. 검은 SUV 문 옆 '탑승' → 빈 자리에 앉는다(최대 5명).
-- 첫 사람이 앉으면 10초 카운트다운, 0이 되면 출발. 차는 서버 시계(SUVTripStart)에 맞춰 각 화면에서 움직이고,
-- 도착하면 서버가 모두를 자리에서 내려 경비실로 옮긴 뒤 근무를 시작한다.
-- 상태는 workspace 속성으로 알린다: SUVState(waiting/countdown/driving/arrived), SUVDepartAt, SUVTripStart, SUVSeat1~5(이름)
local IntroPath = require(ReplicatedStorage:WaitForChild("IntroPath"))
local suv = school:FindFirstChild("IntroCar")
local rideSeats = {}
local lobbyCF, parkedCF
local function groundY(pos, ignore)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.RespectCanCollide = true
	local hit = workspace:Raycast(Vector3.new(pos.X, pos.Y + 4, pos.Z), Vector3.new(0, -30, 0), params)
	return hit and hit.Position.Y or 0.22
end
if suv then
	for _, d in ipairs(suv:GetDescendants()) do
		if d:IsA("Seat") and d.Name == "RideSeat" then
			table.insert(rideSeats, d)
		end
	end
	table.sort(rideSeats, function(a, b)
		return (a:GetAttribute("SeatIndex") or 0) < (b:GetAttribute("SeatIndex") or 0)
	end)
	lobbyCF = suv:GetPivot()
	-- 기준점(차체 가운데)이 바닥에서 얼마나 떠 있는지
	local rideH = lobbyCF.Position.Y - groundY(lobbyCF.Position - Vector3.new(0, 2, 0), { suv })
	workspace:SetAttribute("SUVRideHeight", rideH)
	local endPos = Config.INTRO_PATH[#Config.INTRO_PATH]
	parkedCF = IntroPath.CFrameAt(Config.INTRO_SECONDS, groundY(Vector3.new(endPos.X, 4, endPos.Z), { suv }) + rideH)
end
workspace:SetAttribute("SUVState", "waiting")
for i = 1, Config.MAX_PLAYERS do
	workspace:SetAttribute("SUVSeat" .. i, "")
	workspace:SetAttribute("SUVSeatUser" .. i, 0)
end

function api.teleportToLobby(player)
	local sp = first("LobbySpawn")
	local r = rootOf(player)
	if sp and r then
		local off = Vector3.new((math.random() - 0.5) * math.max(0, sp.Size.X - 2), 3.5, (math.random() - 0.5) * math.max(0, sp.Size.Z - 2))
		local pos = sp.Position + off
		local look = lobbyCF and Vector3.new(lobbyCF.Position.X, pos.Y, lobbyCF.Position.Z) or pos + Vector3.new(0, 0, -1)
		player.Character:PivotTo(CFrame.lookAt(pos, look))
	end
end

local savedJump = {}
local function setJumpLocked(hum, locked)
	if locked then
		savedJump[hum] = { hum.JumpPower, hum.JumpHeight }
		hum.JumpPower = 0
		hum.JumpHeight = 0
	elseif savedJump[hum] then
		hum.JumpPower = savedJump[hum][1]
		hum.JumpHeight = savedJump[hum][2]
		savedJump[hum] = nil
	end
end

local function playerOn(seat)
	local occ = seat.Occupant
	return occ and Players:GetPlayerFromCharacter(occ.Parent), occ
end
local function refreshSeats()
	local n = 0
	for i, seat in ipairs(rideSeats) do
		local p = playerOn(seat)
		workspace:SetAttribute("SUVSeat" .. i, p and p.DisplayName or "")
		workspace:SetAttribute("SUVSeatUser" .. i, p and p.UserId or 0)
		if p then
			n = n + 1
		end
	end
	return n
end

-- 근무 시작 처리 (차로 왔든, 늦게 왔든)
local function finishIntro(player)
	if player:GetAttribute("IntroDone") then
		return
	end
	player:SetAttribute("IntroDone", true)
	player:SetAttribute("Sanity", Config.START_SANITY)
	local hrp = rootOf(player)
	if hrp then
		hrp.Anchored = false
	end
	api.teleportToBooth(player)
	startShift()
end

local prompts = {}
local lastOccupant = {}
local function exitBeside(hum)
	-- 출발 전에 내리면 인도 쪽 문 옆에 내려 준다
	local ch = hum.Parent
	if ch and ch.Parent and lobbyCF then
		local pos = lobbyCF.Position + lobbyCF.RightVector * 5.5
		ch:PivotTo(CFrame.new(Vector3.new(pos.X, groundY(pos, { suv, ch }) + 3.2, pos.Z)))
	end
end
for _, seat in ipairs(rideSeats) do
	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local prev = lastOccupant[seat]
		lastOccupant[seat] = seat.Occupant
		local st = workspace:GetAttribute("SUVState")
		if prev and not seat.Occupant and prev.Parent and prev.Health > 0 then
			local p = Players:GetPlayerFromCharacter(prev.Parent)
			if st == "driving" and p and not p:GetAttribute("IntroDone") then
				task.defer(function()
					if not seat.Occupant then
						seat:Sit(prev) -- 달리는 중엔 못 내린다
					end
				end)
			elseif st == "waiting" or st == "countdown" then
				task.defer(exitBeside, prev)
			end
		end
		refreshSeats()
	end)
end
for _, door in ipairs(tagged("SUVDoor")) do
	if suv and door:IsDescendantOf(suv) then
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "탑승"
		prompt.ObjectText = "출근 차량"
		prompt.HoldDuration = 0.4
		prompt.MaxActivationDistance = 11
		prompt.RequiresLineOfSight = false
		prompt.Parent = door
		table.insert(prompts, prompt)
		prompt.Triggered:Connect(function(player)
			local st = workspace:GetAttribute("SUVState")
			if player:GetAttribute("IntroDone") or (st ~= "waiting" and st ~= "countdown") then
				return
			end
			local ch = player.Character
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			if not hum or hum.Health <= 0 or hum.SeatPart then
				return
			end
			for _, seat in ipairs(rideSeats) do
				if not seat.Occupant then
					seat:Sit(hum)
					return
				end
			end
			api.say(player, "자리가 다 찼어요 (최대 " .. Config.MAX_PLAYERS .. "명)", 2.5, "yellow")
		end)
	end
end

local function arrive(riders)
	if suv and parkedCF then
		suv:PivotTo(parkedCF)
	end
	for _, r in ipairs(riders) do
		local w = r.seat:FindFirstChild("SeatWeld")
		if w then
			w:Destroy()
		end
		if r.hum.Parent then
			r.hum.Sit = false
			setJumpLocked(r.hum, false)
		end
		if r.player.Parent then
			finishIntro(r.player)
		end
	end
	workspace:SetAttribute("SUVState", "arrived")
	refreshSeats()
end

local function depart()
	workspace:SetAttribute("SUVState", "driving")
	workspace:SetAttribute("SUVTripStart", workspace:GetServerTimeNow() + 0.4)
	for _, pr in ipairs(prompts) do
		pr.Enabled = false
	end
	local riders = {}
	for _, seat in ipairs(rideSeats) do
		local p, hum = playerOn(seat)
		if p then
			table.insert(riders, { player = p, hum = hum, seat = seat })
			setJumpLocked(hum, true)
		end
	end
	task.delay(Config.INTRO_SECONDS + 0.5, arrive, riders)
end

-- 카운트다운 + 차를 놓친 사람 처리
local lateSince = {}
task.spawn(function()
	while true do
		task.wait(0.2)
		local st = workspace:GetAttribute("SUVState")
		local n = refreshSeats()
		if st == "waiting" and n > 0 then
			workspace:SetAttribute("SUVDepartAt", workspace:GetServerTimeNow() + Config.DEPART_DELAY)
			workspace:SetAttribute("SUVState", "countdown")
		elseif st == "countdown" then
			if n == 0 then
				workspace:SetAttribute("SUVState", "waiting") -- 모두 내리면 처음부터
			elseif workspace:GetServerTimeNow() >= (workspace:GetAttribute("SUVDepartAt") or 0) then
				depart()
			end
		elseif st == "driving" or st == "arrived" or not suv then
			for _, p in ipairs(Players:GetPlayers()) do
				local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
				local riding = hum and hum.SeatPart and hum.SeatPart.Name == "RideSeat"
				if not p:GetAttribute("IntroDone") and hum and not riding then
					lateSince[p] = lateSince[p] or os.clock()
					if os.clock() - lateSince[p] >= Config.LATE_ARRIVAL_SECONDS then
						lateSince[p] = nil
						finishIntro(p)
					end
				end
			end
		end
	end
end)
Players.PlayerRemoving:Connect(function(p)
	lateSince[p] = nil
end)

-- ───────── 플레이어 ─────────
local GuardOutfit = require(ServerScriptService:WaitForChild("GuardOutfit"))

local function onCharacter(player, character)
	local hrp = character:WaitForChild("HumanoidRootPart", 10)
	local hum = character:WaitForChild("Humanoid", 10)
	if not hrp or not hum then
		return
	end
	task.wait()
	if player:GetAttribute("IntroDone") then
		api.teleportToBooth(player)
	else
		api.teleportToLobby(player) -- 처음엔 로비(편의점 앞)에서 출근 차량을 기다린다
	end
	hum.Died:Connect(function()
		task.delay(Players.RespawnTime, function()
			if player.Parent and player.Character == character then
				player:LoadCharacter()
			end
		end)
	end)
	if Config.GUARD_OUTFIT then
		GuardOutfit.Apply(player, character)
	end
	-- 가슴 앞에 든 손전등 (다른 플레이어에게 보이는 불빛). 내 화면에선 카메라에 붙은 손전등을 쓴다
	local fl = Instance.new("Part")
	fl.Name = "HeldFlashlight"
	fl.Size = Vector3.new(0.32, 0.32, 1.2)
	fl.Color = Color3.fromRGB(28, 28, 30)
	fl.Material = Enum.Material.Metal
	fl.CanCollide = false
	fl.CanQuery = false
	fl.CanTouch = false
	fl.Massless = true
	local lens = Instance.new("Part")
	lens.Name = "Lens"
	lens.Shape = Enum.PartType.Cylinder
	lens.Size = Vector3.new(0.06, 0.4, 0.4)
	lens.Material = Enum.Material.Neon
	lens.Color = Color3.fromRGB(255, 244, 220)
	lens.CanCollide = false
	lens.CanQuery = false
	lens.CanTouch = false
	lens.Massless = true
	lens.CFrame = fl.CFrame * CFrame.new(0, 0, -0.62) * CFrame.Angles(0, math.rad(90), 0)
	local lw = Instance.new("WeldConstraint")
	lw.Part0, lw.Part1 = fl, lens
	lw.Parent = fl
	lens.Parent = fl
	local beam = Instance.new("SpotLight")
	beam.Name = "Beam"
	beam.Face = Enum.NormalId.Front
	beam.Range = 50
	beam.Angle = 42
	beam.Brightness = 2.4
	beam.Color = Color3.fromRGB(255, 238, 210)
	beam.Shadows = true
	beam.Enabled = player:GetAttribute("FlashOn") ~= false
	beam.Parent = fl
	fl.CFrame = hrp.CFrame * CFrame.new(0.85, 0.9, -0.9)
	local w = Instance.new("WeldConstraint")
	w.Part0, w.Part1 = hrp, fl
	w.Parent = fl
	fl.Parent = character
	local function syncBeam()
		local on = player:GetAttribute("FlashOn") ~= false
		beam.Enabled = on
		lens.Material = on and Enum.Material.Neon or Enum.Material.Glass
	end
	syncBeam()
	player:GetAttributeChangedSignal("FlashOn"):Connect(syncBeam)
end

Players.PlayerAdded:Connect(function(player)
	player:SetAttribute("Sanity", Config.START_SANITY)
	player:SetAttribute("IntroDone", false)
	player:SetAttribute("Ended", false)
	resetPatrol(player)
	player.CharacterAdded:Connect(function(ch)
		onCharacter(player, ch)
	end)
	player:LoadCharacter()
end)
for _, player in ipairs(Players:GetPlayers()) do
	player:SetAttribute("Sanity", Config.START_SANITY)
	player:SetAttribute("IntroDone", player:GetAttribute("IntroDone") or false)
	resetPatrol(player)
	player.CharacterAdded:Connect(function(ch)
		onCharacter(player, ch)
	end)
	task.spawn(function()
		player:LoadCharacter()
	end)
end

-- (예전 혼자 보는 인트로용. 이제는 서버가 출근 차량 도착 때 근무를 시작시킨다)
IntroFinished.OnServerEvent:Connect(function() end)

FlashToggle.OnServerEvent:Connect(function(player, on)
	player:SetAttribute("FlashOn", on == true)
end)

ChairGaze.OnServerEvent:Connect(function(player)
	Anomalies.OnChairGaze(player)
end)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX0000000D">
			<Properties>
				<string name="Name">SchoolBuilder</string>
				<ProtectedString name="Source"><![CDATA[-- 송천고등학교 맵 빌더
-- MapData*.lua (tools/generate.js 가 만든 데이터)를 읽어서 파트로 지어 줍니다.
--
-- Studio에서 맵을 미리 지어 두고 싶으면 (편집 모드에서) 명령 바에 붙여 넣으세요:
--   require(game.ServerScriptService.SchoolBuilder).Build(workspace, false)
-- 그 다음 파일 저장하면 맵이 장소에 그대로 남습니다. (이미 있으면 게임 시작 때 다시 짓지 않아요)

local HttpService = game:GetService("HttpService")
local AtlasText = require(game:GetService("ReplicatedStorage"):WaitForChild("AtlasText"))
local CollectionService = game:GetService("CollectionService")

local Builder = {}

local SHAPES = { [1] = Enum.PartType.Ball, [2] = Enum.PartType.Cylinder }

local function material(name)
	local ok, m = pcall(function()
		return Enum.Material[name]
	end)
	if ok and m then
		return m
	end
	return Enum.Material.SmoothPlastic
end

local function font(name)
	local ok, f = pcall(function()
		return Enum.Font[name]
	end)
	if ok and f then
		return f
	end
	return Enum.Font.GothamBold
end

local function band(a, b)
	return math.floor(a / b) % 2 == 1
end

function Builder.Build(parent, yield)
	parent = parent or workspace
	if yield == nil then
		yield = true
	end
	local existing = parent:FindFirstChild("School")
	if existing then
		return existing
	end

	local header = HttpService:JSONDecode(require(script.MapData0))
	local colors, mats = {}, {}
	for i, c in ipairs(header.colors) do
		colors[i - 1] = Color3.fromRGB(c[1], c[2], c[3])
	end
	for i, m in ipairs(header.mats) do
		mats[i - 1] = material(m)
	end

	-- 지형 (잔디·흙·포장·먼 산). 이미 지형이 있으면 건드리지 않음
	local terrain = workspace.Terrain
	if header.terrain and not terrain:GetAttribute("SchoolTerrain") then
		terrain:SetAttribute("SchoolTerrain", true)
		for i, t in ipairs(header.terrain) do
			local mat = material(t[2])
			if t[1] == 1 then
				terrain:FillBall(Vector3.new(t[3], t[4], t[5]), t[6], mat)
			else
				terrain:FillBlock(CFrame.new(t[3], t[4], t[5]), Vector3.new(t[6], t[7], t[8]), mat)
			end
			if yield and i % 4 == 0 then
				task.wait()
			end
		end
	end
	pcall(function()
		terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(92, 104, 58))
		terrain:SetMaterialColor(Enum.Material.LeafyGrass, Color3.fromRGB(84, 92, 52))
		terrain:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB(150, 128, 98))
		terrain:SetMaterialColor(Enum.Material.Pavement, Color3.fromRGB(140, 138, 132))
		terrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(108, 104, 98))
		terrain.Decoration = true
	end)

	-- 그룹(모델) 만들기: 경로 순서대로 부모가 먼저 나온다
	local groupObj, byPath = {}, {}
	for i, path in ipairs(header.groups) do
		local segs = string.split(path, "/")
		local obj
		if #segs == 1 then
			obj = Instance.new("Folder")
		else
			obj = Instance.new("Model")
		end
		obj.Name = segs[#segs]
		if #segs > 1 then
			local parentPath = table.concat(segs, "/", 1, #segs - 1)
			obj.Parent = byPath[parentPath]
		end
		byPath[path] = obj
		groupObj[i - 1] = obj
	end
	local root = groupObj[0]

	-- 파트
	local parts = {}
	local count = 0
	for chunk = 1, header.partChunks do
		local list = HttpService:JSONDecode(require(script["MapData" .. chunk]))
		for _, r in ipairs(list) do
			local shape = r[15]
			local p
			if r[2] == "RideSeat" then
				p = Instance.new("Seat") -- 출근 차량 좌석: 서버가 Sit 으로 앉힌다
			elseif shape == 3 then
				p = Instance.new("WedgePart")
			else
				p = Instance.new("Part")
				if SHAPES[shape] then
					p.Shape = SHAPES[shape]
				end
			end
			p.Name = r[2]
			p.Anchored = true
			p.Size = Vector3.new(r[3], r[4], r[5])
			p.CFrame = CFrame.new(r[6], r[7], r[8]) * CFrame.Angles(math.rad(r[9]), math.rad(r[10]), math.rad(r[11]))
			p.Color = colors[r[12]]
			p.Material = mats[r[13]]
			p.Transparency = r[14]
			if r[17] and r[17] > 0 then
				p.Reflectance = r[17]
			end
			p.TopSurface = Enum.SurfaceType.Smooth
			p.BottomSurface = Enum.SurfaceType.Smooth
			local flags = r[16]
			if band(flags, 1) then
				p.CanCollide = false
			end
			if band(flags, 2) then
				p.CastShadow = false
			end
			if band(flags, 8) then
				-- 판정용 투명 영역
				p.CanCollide = false
				p.CanTouch = false
				p.CastShadow = false
				p.Locked = true
			end
			local g = groupObj[r[1]]
			p.Parent = g
			if band(flags, 4) and g:IsA("Model") then
				g.PrimaryPart = p
			end
			parts[count] = p
			count = count + 1
			if yield and count % 1500 == 0 then
				task.wait()
			end
		end
	end

	-- 조명
	for _, L in ipairs(header.lights) do
		local p = parts[L[1]]
		local light
		if L[2] == 1 then
			light = Instance.new("SpotLight")
			light.Angle = L[8]
			light.Face = Enum.NormalId[L[7]]
		elseif L[2] == 2 then
			light = Instance.new("SurfaceLight")
			light.Angle = math.min(L[8], 90)
			light.Face = Enum.NormalId[L[7]]
		else
			light = Instance.new("PointLight")
		end
		light.Range = math.min(L[3], 60)
		light.Brightness = L[4]
		light.Color = colors[L[5]]
		light.Enabled = L[6] == 1
		light.Shadows = L[9] == 1
		light.Parent = p
	end

	-- 글씨 (SurfaceGui)
	for _, T in ipairs(header.texts) do
		local p = parts[T[1]]
		local gui = Instance.new("SurfaceGui")
		gui.Name = "Text"
		gui.Face = Enum.NormalId[T[2]]
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = T[10]
		gui.LightInfluence = T[8]
		if T[8] < 1 then
			gui.Brightness = 1.6
		end
		gui.ResetOnSpawn = false
		if T[7] == "Atlas" then
			-- 손글씨 그림 글자 (AtlasText)
			-- 흰 글씨 그림(간판)은 데이터의 글자색으로 물들인다
			AtlasText.Make(T[3], gui, nil, T[4] and colors[T[4]] or nil)
		else
			local label = Instance.new("TextLabel")
			label.Name = "Label"
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundColor3 = colors[T[5]]
			label.BackgroundTransparency = T[6]
			label.BorderSizePixel = 0
			label.TextColor3 = colors[T[4]]
			label.Font = font(T[7])
			label.Text = T[3]
			label.TextScaled = true
			label.TextWrapped = true
			if T[9] == "Left" then
				label.TextXAlignment = Enum.TextXAlignment.Left
				local pad = Instance.new("UIPadding")
				pad.PaddingLeft = UDim.new(0.04, 0)
				pad.PaddingRight = UDim.new(0.04, 0)
				pad.PaddingTop = UDim.new(0.03, 0)
				pad.PaddingBottom = UDim.new(0.03, 0)
				pad.Parent = label
			end
			label.Parent = gui
		end
		gui.Parent = p
	end

	-- PrimaryPart가 없는 모델은 기준점(피벗)을 모델 한가운데로
	for _, g in pairs(groupObj) do
		if g:IsA("Model") and not g.PrimaryPart and #g:GetChildren() > 0 then
			local ok, cf = pcall(function()
				return g:GetBoundingBox()
			end)
			if ok and cf then
				g.WorldPivot = CFrame.new(cf.Position)
			end
		end
	end

	-- 태그와 속성 (스크립트가 찾을 때 씀)
	for _, t in ipairs(header.tags) do
		CollectionService:AddTag(parts[t[1]], t[2])
	end
	for _, t in ipairs(header.gtags) do
		CollectionService:AddTag(groupObj[t[1]], t[2])
	end
	for _, a in ipairs(header.attrs) do
		parts[a[1]]:SetAttribute(a[2], a[3])
	end

	-- 이상현상 소품은 ServerStorage에 보관 (이상현상이 일어날 때 복제해서 씀)
	local props = root:FindFirstChild("AnomalyProps")
	if props then
		local ServerStorage = game:GetService("ServerStorage")
		local old = ServerStorage:FindFirstChild("AnomalyProps")
		if old then
			old:Destroy()
		end
		props.Parent = ServerStorage
	end

	root.Parent = parent

	-- 메시 에셋(SongcheonAssets)을 가져왔다면 나무·책걸상 등을 사실적인 메시로 바꾼다
	local okLib, AssetLibrary = pcall(function()
		return require(script.Parent:FindFirstChild("AssetLibrary"))
	end)
	if okLib and AssetLibrary then
		pcall(AssetLibrary.Apply, root, yield)
	end
	return root
end

return Builder
]]></ProtectedString>
			</Properties>
			<Item class="ModuleScript" referent="RBX0000000E">
				<Properties>
					<string name="Name">MapData0</string>
					<ProtectedString name="Source"><![CDATA[-- 자동 생성 파일 (tools/generate.js). 직접 고치지 마세요.
return [==[{"v":2,"groups":["School","School/Street","School/Street/BusStop","School/Street/StreetLight","School/Street/UtilityPole","School/Street/Wires","School/Town","School/Town/ShopBuilding","School/Town/Apartment","School/Wall","School/Gate","School/Gate/MainGate","School/Gate/SideGate","School/GuardBooth","School/GuardBooth/Door","School/GuardBooth/ACOutdoor","School/GuardBooth/CCTV","School/GuardBooth/Phone","School/GuardBooth/RulesNotebook","School/GuardBooth/DeskCalendar","School/GuardBooth/DeskLamp","School/GuardBooth/OfficeChair","School/GuardBooth/Bed","School/GuardBooth/WallClock","School/GuardBooth/KeyBox","School/GuardBooth/Heater","School/GuardBooth/WaterPurifier","School/GuardBooth/Barrier","School/Grounds","School/Grounds/SoccerGoal","School/Grounds/Stands","School/Grounds/Flagpole","School/Grounds/Pergola","School/Grounds/PullUpBars","School/Grounds/FloodLight","School/Grounds/BasketballCourt","School/Grounds/BasketballCourt/Hoop","School/Grounds/Tree1","School/Grounds/Tree2","School/Grounds/Tree3","School/Grounds/Tree4","School/Grounds/Tree5","School/Grounds/Tree6","School/Grounds/Tree7","School/Grounds/Tree8","School/Grounds/Tree9","School/Grounds/Tree10","School/Grounds/Tree11","School/Grounds/Tree12","School/Grounds/Tree13","School/Grounds/Tree14","School/Grounds/Tree15","School/Grounds/Tree16","School/Grounds/Tree17","School/Grounds/Tree18","School/Grounds/Tree19","School/Grounds/Tree20","School/Grounds/Tree21","School/Grounds/Tree22","School/Grounds/Tree23","School/Grounds/Tree24","School/Grounds/Tree25","School/Grounds/Tree26","School/Grounds/Tree27","School/Grounds/Tree28","School/Grounds/Tree29","School/Grounds/Tree30","School/Grounds/Tree31","School/Grounds/Tree32","School/Grounds/Tree33","School/Grounds/Tree34","School/Grounds/Tree35","School/Grounds/Tree36","School/Grounds/Tree37","School/Grounds/Tree38","School/Grounds/Tree39","School/Grounds/Tree40","School/Grounds/Tree41","School/Grounds/Tree42","School/Grounds/Tree43","School/Grou