,-89.88,1.804,60.448,-4.558,1879,3,1,0,3,0],[95,"LeafG",5.039,4.636,0.05,17.331,15.23,-89.88,-7.772,120.448,4.946,1879,3,1,0,3,0],[95,"LeafG",5.039,5.039,0.05,17.331,15.634,-89.88,90,0.448,0,1879,3,1,0,3,0],[95,"Branch",3.517,0.715,0.715,19.043,13.686,-91.207,0,121.76,44.231,1877,7,0,2,1,0],[95,"Branch",2.344,0.465,0.465,17.937,15.731,-92.993,0,121.76,44.231,1877,7,0,2,3,0],[95,"Twig",2.641,0.214,0.214,16.313,17.129,-93.801,0,175.442,26.11,1877,7,0,2,3,0],[95,"LeafG",6.153,5.661,0.05,15.132,17.71,-93.895,-3.49,97.073,5.659,18,3,1,0,3,0],[95,"LeafG",6.153,5.661,0.05,15.132,17.71,-93.895,-0.708,157.073,1.179,18,3,1,0,3,0]]]==]
