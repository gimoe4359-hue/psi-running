,44.1,2.335,-107.143,77.143,0,90,382,19,0,2,3,0],[104,"Rim",0.454,0.07,0.07,44.1,2.239,-106.679,-77.143,0,-90,1412,19,0,2,3,0],[104,"Rim",0.454,0.07,0.07,44.1,2.047,-106.28,-51.429,0,-90,1412,19,0,2,3,0],[104,"Rim",0.454,0.07,0.07,44.1,1.701,-106.004,-25.714,0,-90,1412,19,0,2,3,0],[104,"Rim",0.454,0.07,0.07,44.1,1.27,-105.906,0,0,-90,1412,19,0,2,3,0],[104,"Rim",0.454,0.07,0.07,44.1,0.839,-106.004,25.714,0,-90,1412,19,0,2,3,0],[104,"Rim",0.454,0.07,0.07,44.1,0.493,-106.28,51.429,0,-90,1412,19,0,2,3,0],[104,"Rim",0.454,0.07,0.07,44.1,0.301,-106.679,77.143,0,-90,1412,19,0,2,3,0],[104,"Rim",0.454,0.07,0.07,44.1,0.301,-107.121,-77.143,0,90,1412,19,0,2,3,0],[104,"Rim",0.454,0.07,0.07,44.1,0.493,-107.52,-51.429,0,90,1412,19,0,2,3,0],[104,"Rim",0.454,0.07,0.07,44.1,0.839,-107.796,-25.714,0,90,1412,19,0,2,3,0],[104,"Rim",0.454,0.07,0.07,44.1,1.27,-107.894,0,0,90,1412,19,0,2,3,0],[104,"Rim",0.454,0.07,0.07,44.1,1.701,-107.796,25.714,0,90,1412,19,0,2,3,0],[104,"Rim",0.454,0.07,0.07,44.1,2.047,-107.52,51.429,0,90,1412,19,0,2,3,0],[104,"Rim",0.454,0.07,0.07,44.1,2.239,-107.121,77.143,0,90,1412,19,0,2,3,0],[104,"Spoke",2,0.05,0.05,44.1,1.27,-106.9,0,0,-90,1413,6,0,2,3,0],[104,"Spoke",2,0.05,0.05,44.1,1.27,-106.9,30,0,-90,1413,6,0,2,3,0],[104,"Spoke",2,0.05,0.05,44.1,1.27,-106.9,60,0,-90,1413,6,0,2,3,0],[104,"Spoke",2,0.05,0.05,44.1,1.27,-106.9,0,90,0,1413,6,0,2,3,0],[104,"Spoke",2,0.05,0.05,44.1,1.27,-106.9,-60,0,90,1413,6,0,2,3,0],[104,"Spoke",2,0.05,0.05,44.1,1.27,-106.9,-30,0,90,1413,6,0,2,3,0]]]==]
