			tris = 1760,
		}, {
			mesh = "Ghost_HairCap",
			name = "Ghost_HairCap",
			size = { 0.7087, 0.6477, 0.716 },
			pos = { -0.0795, 5.2798, -0.0752 },
			color = { 10, 9, 9 },
			material = "SmoothPlastic",
			reflectance = 0,
			transparency = 0,
			collide = false,
			shadow = true,
			tris = 6448,
		}, {
			mesh = "Ghost_HairA",
			name = "Ghost_HairA",
			size = { 0.8768, 2.6126, 0.9238 },
			pos = { -0.007, 4.3158, -0.0514 },
			color = { 12, 10, 10 },
			material = "SmoothPlastic",
			reflectance = 0.03,
