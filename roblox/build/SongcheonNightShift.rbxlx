		{ kind = "nine", indent = 0.66, strokes = { {3.24,-0.36,3.25,-0.14},{2.01,-0.33,2,-0.13,2.21,-0.19},{0.45,-0.33,0.44,-0.22},{1.13,-0.29,1.14,0.02},{2.46,-0.26,2.58,-0.33,2.64,-0.32,2.63,-0.09},{4.33,-0.26,4.35,-0.04},{0.19,-0.25,0.08,-0.24},{0.07,-0.24,0.06,-0.01,0.09,0.02,0.17,-0.01,0.31,-0.14},{0.64,-0.24,0.45,-0.21},{0.85,-0.22,0.8,-0.12},{0.44,-0.21,0.45,-0.02},{3.71,-0.19,3.48,0.04,3.42,0,3.41,-0.16},{3.72,-0.19,3.75,0.1},{4.61,-0.17,4.61,-0.22,4.67,-0.26,4.75,-0.26,4.79,-0.23,4.79,-0.16,4.69,-0.02,4.7,0.05},{0.8,-0.12,0.71,0.03},{0.8,-0.12,0.84,-0.07,0.87,0.14},{3.89,-0.09,4.02,-0.13,4.03,-0.04},{4.5,-0.09,4.35,-0.04},{1.58,-0.08,1.27,-0.02},{4.35,-0.04,4.36,0.12},{4.03,-0.04,4.18,-0.09,4.18,0.1},{4.03,-0.04,4.02,0.08},{2.74,-0.02,2.6,0},{2.32,-0.01,2.18,0.01},{2.6,0.01,2.43,0.04},{2.6,0.01,2.62,0.26},{2.17,0.01,1.98,0.05},{2.18,0.01,2.16,0.25},{3.25,0.02,3.25,0.15},{3.05,0.03,3.06,0.28},{1.41,0.04,1.4,0.2,1.62,0.16},{0.39,0.08,0.33,0.18,0.34,0.24,0.41,0.22,0.47,0.17,0.48,0.13,0.46,0.08},{1.02,0.1,1.03,0.23,1.12,0.22,1.22,0.17},{3.24,0.15,3.15,0.2,3.15,0.27,3.19,0.29,3.23,0.27,3.25,0.16},{1.4,-0.32,1.45,-0.27,1.4,-0.18,1.35,-0.2,1.4,-0.32},{2.94,-0.22,2.99,-0.15,2.96,-0.1,2.91,-0.09,2.88,-0.09,2.87,-0.11,2.94,-0.22} } },
