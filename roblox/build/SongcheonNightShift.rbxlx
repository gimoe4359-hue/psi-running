local flashWanted = true
local function setFlash(on)
	flashWanted = on
	flash.Enabled = on and player:GetAttribute("IntroDone") == true
	flashBtn.BackgroundColor3 = on and Color3.fromRGB(200, 170, 80) or Color3.fromRGB(30, 34, 46)
end
