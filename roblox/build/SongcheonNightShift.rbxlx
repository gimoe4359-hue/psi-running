make("Frame", { Position = UDim2.new(0, 404, 0, 14), Size = UDim2.new(0, 12, 0, 480), BackgroundColor3 = Color3.fromRGB(196, 188, 166), BorderSizePixel = 0, ZIndex = 62 }, paper)
for i = 0, 11 do
