에 없다면, 찾지 마세요.",74,73,0,"Arial",1,"Left",60],[1120,"Back","11월\n13일(금)",76,75,0,"GothamBold",1,"Center",50],[1183,"Top","P  교직원",13,13,1,"GothamBold",1,"Center",50],[1210,"Front","12가 3456",96,97,0,"GothamBold",1,"Center",50],[1211,"Back","12가 3456",96,97,0,"GothamBold",1,"Center",50],[1238,"Front","48라 9012",96,97,0,"GothamBold",1,"Center",50],[1239,"Back","48라 9012",96,97,0,"GothamBold",1,"Center",50],[1266,"Front","경기 77바 1004",96,97,0,"GothamBold",1,"Center",50],[1267,"Back","경기 77바 1004",96,97,0,"GothamBold",1,"Center",50],[2055,"Left","체 육 관",13,132,0,"GothamBold",0.6,"Center",50],[2428,"Right","비상구 EXIT",13,13,1,"GothamBlack",0,"Center",50],[2441,"Left","비상구 EXIT",13,13,1,"GothamBlack",0,"Center",50],[2458,"Front","교무실",147,146,0,"GothamBold",1,"Center",50],[2556,"Right","11월 행사\n· 13일(금) 야간경비 교대\n· 신규 경비원: 공유 씨\n· ※ 4층 출입 금지",153,13,1,"PatrickHand",1,"Center",50],[2589,"Front","1학년 1반",147,146,0,"GothamBold",1,"Center",50],[2591,"Right","11월 13일 (금)\n주번: 이○○\n\n수행평가 제출",160,159,1,"PatrickHand",1,"Center",50],[2595,"Right","급훈  늦게까지 남지 말자",126,162,0,"Merriweather",1,"Center",50],[2933,"Front","행정실",147,146,0,"GothamBold",1,"Center",50],[2976,"Front","1학년 2반",147,146,0,"GothamBold",1,"Center",50],[2979,"Right","11월 13일 (금)\n주번: 박○○\n\n자습",160,159,1,"PatrickHand",1,"Center",50],[2983,"Right","급훈  늦게까지 남지 말자",126,162,0,"Merriweather",1,"Center",50],[3315,"Front","보건실",147,146,0,"GothamBold",1,"Center",50],[3332,"Left","E\nㅂ ㅍ\nㅁ ㅎ ㄹ\n나 를 봐\n뒤 에 있 어",188,13,1,"Arial",1,"Center",50],[3362,"Front","1학년 3반",147,146,0,"GothamBold",1,"Center",50],[3365,"Right","11월 13일 (금)\n주번: 이○○\n\n수행평가 제출",160,159,1,"PatrickHand",1,"Center",50],[3369,"Right","급훈  늦게까지 남지 말자",126,162,0,"Merriweather",1,"Center",50],[3702,"Front","방송실",147,146,0,"GothamBold",1,"Center",50],[3725,"Right","ON AIR",193,13,1,"GothamBlack",0,"Center",50],[3756,"Front","과학실",147,146,0,"GothamBold",1,"Center",50],[3759,"Right","",160,159,1,"PatrickHand",1,"Center",50],[3763,"Right","급훈  늦게까지 남지 말자",126,162