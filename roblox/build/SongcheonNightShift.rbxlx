<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<External>null</External>
	<External>nil</External>
	<Item class="Workspace" referent="RBX00000000">
		<Properties>
			<string name="Name">Workspace</string>
			<bool name="StreamingEnabled">false</bool>
			<float name="FallenPartsDestroyHeight">-500</float>
		</Properties>
	</Item>
	<Item class="Lighting" referent="RBX00000001">
		<Properties>
			<string name="Name">Lighting</string>
			<float name="ClockTime">22</float>
			<bool name="GlobalShadows">true</bool>
		</Properties>
	</Item>
	<Item class="ReplicatedStorage" referent="RBX00000002">
		<Properties>
			<string name="Name">ReplicatedStorage</string>
		</Properties>
		<Item class="ModuleScript" referent="RBX00000003">
			<Properties>
				<string name="Name">Config</string>
				<ProtectedString name="Source"><![CDATA[-- 싸이 뛰어! 나폴리탄 괴담: 송천고 야간 경비 — 설정
-- 숫자만 바꾸면 되는 것들을 모아 둔 곳

local Config = {}

-- ───────── 공유 스킨 (무료) ─────────
-- roblox/clothes/guard_shirt.png, guard_pants.png 를 Studio에서 업로드(무료)한 뒤
-- 나온 "이미지 ID" 숫자를 넣으세요. 0이면 옷 대신 몸 색깔로 남색 유니폼을 흉내 냅니다.
Config.SHIRT_IMAGE_ID = 0
Config.PANTS_IMAGE_ID = 0
-- (선택) 마켓의 무료 머리·얼굴 아이템 ID. 0이면 플레이어 원래 머리 대신 기본 짧은 머리 모양 파츠를 씌움
Config.HAIR_ACCESSORY_ID = 0
Config.FACE_ID = 0
Config.SKIN_COLOR = Color3.fromRGB(234, 196, 160)
Config.HERO_NAME = "공유"

-- ───────── 시간 ─────────
Config.SECONDS_PER_GAME_HOUR = 75 -- 22:00~06:00 = 8시간 = 10분
Config.SHIFT_START_HOUR = 22
Config.SHIFT_HOURS = 8

-- ───────── 이상현상 ─────────
Config.ANOMALY_MIN_GAP = 22
Config.ANOMALY_MAX_GAP = 40
Config.MAX_ACTIVE_ANOMALIES = 2
Config.FIRST_ANOMALY_DELAY = 20

-- ───────── 정신력 ─────────
Config.START_SANITY = 100
Config.PATROL_MISS_PENALTY = 15

-- ───────── 소리 (선택) ─────────
-- Creator Store에서 쓸 수 있는 사운드 ID를 넣으면 재생됩니다. 0이면 자막만 나와요.
Config.SOUNDS = {
	Ambience = 0, -- 밤 학교 배경음 (반복)
	PhoneRing = 0, -- 전화벨
	Knock = 0, -- 철문 두드리는 소리
	Bell = 0, -- 학교 종소리
	Whisper = 0, -- 속삭임
	Static = 0, -- 방송 잡음
	GateClose = 0, -- 철문 닫히는 소리
	Car = 0, -- 자동차 엔진
}

-- ───────── 근무 수칙 (경비실 벽 종이와 같은 내용) ─────────
Config.RULES = {
	"근무는 22:00 ~ 06:00. 06시 전엔 절대 정문을 열지 마세요.",
	"매시 정각 전, 1층·2층·3층 순찰함에 체크하세요.",
	"4층은 없습니다. 4층 표지판이 보이면 즉시 경비실로.",
	"전화가 오면 받으세요. 단, 당신 이름을 부르면 끊으세요.",
	"운동장에 의자가 있으면 쳐다보지 마세요.",
	"시계탑이 거꾸로 가면 건물에 들어가지 마세요.",
	"복도의 학생에게 말을 걸지 마세요. 학생들은 모두 하교했습니다.",
	"동상이 자리에 없다면, 찾지 마세요.",
}
-- 가끔 수칙 종이에 몰래 나타나는 9번
Config.RULE_NINE = "9. 경비원은 한 명입니다. 경비실에 누가 앉아 있다면, 당신은 누구입니까?"

-- ───────── 인트로 (차 타고 학교로) ─────────
-- 자동차가 지나갈 길 (X, Z). 마지막 점이 주차 위치(IntroCar가 원래 놓인 자리)입니다.
Config.INTRO_PATH = {
	Vector3.new(-430, 0, 233),
	Vector3.new(-200, 0, 233),
	Vector3.new(-60, 0, 233),
	Vector3.new(-18, 0, 229),
	Vector3.new(-1, 0, 214),
	Vector3.new(0, 0, 196),
	Vector3.new(0, 0, 182),
	Vector3.new(14, 0, 176),
	Vector3.new(34, 0, 172),
	Vector3.new(43.8, 0, 166),
	Vector3.new(43.8, 0, 159),
}
Config.INTRO_SECONDS = 22
Config.INTRO_LINES = {
	{ 0.5, "11월 13일 금요일, 밤 9시 50분." },
	{ 4.0, "공유: 야간 경비 알바, 시급 3만 원… 이 정도면 꿀알바지." },
	{ 9.0, "공유: 송천고등학교. 여기구나." },
	{ 13.5, "철컥— 정문이 혼자 열렸다." },
	{ 18.0, "공유: …주차하고, 경비실부터 가 보자." },
}
Config.AFTER_INTRO_LINES = {
	{ 0.0, "끼이이익… 쾅." },
	{ 2.2, "공유: …방금 문, 누가 닫았지?" },
	{ 5.0, "책상 위에 '근무 수칙'이 붙어 있다. 꼭 읽어 보자." },
}

return Config
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX00000004">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="ModuleScript" referent="RBX00000005">
			<Properties>
				<string name="Name">Anomalies</string>
				<ProtectedString name="Source"><![CDATA[-- 이상현상 모음
-- 근무 중에 무작위로 하나씩(최대 Config.MAX_ACTIVE_ANOMALIES 개 동시) 일어납니다.
-- 근무 수칙과 연결된 이상현상은 수칙을 어기면 정신력이 깎입니다.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Config = require(ReplicatedStorage:WaitForChild("Config"))

local Anomalies = {}
Anomalies.clockBackward = false

local api
local defs = {}
local active = {}
local generation = 0
local lastName = nil

local function tagged(tag)
	return CollectionService:GetTagged(tag)
end
local function first(tag)
	return tagged(tag)[1]
end
local function pick(list)
	return list[math.random(1, #list)]
end

local function def(name, minHour, duration, start, stop)
	table.insert(defs, { name = name, minHour = minHour, duration = duration, start = start, stop = stop or function() end })
end
local function findDef(name)
	for _, d in ipairs(defs) do
		if d.name == name then
			return d
		end
	end
	return nil
end

-- ───────── 파트로 만드는 소품 ─────────
local function block(parent, name, size, cf, color, mat)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- 얼굴을 긴 머리로 가린 학생. baseCF = 발밑, LookVector = 바라보는 쪽
local function makeStudent(baseCF)
	local m = Instance.new("Model")
	m.Name = "AnomalyStudent"
	local uni = Color3.fromRGB(26, 29, 38)
	local skirt = Color3.fromRGB(58, 26, 30)
	local pale = Color3.fromRGB(190, 184, 176)
	local hair = Color3.fromRGB(6, 6, 6)
	local function at(x, y, z)
		return baseCF * CFrame.new(x, y, z)
	end
	local torso = block(m, "Torso", Vector3.new(2, 2, 1), at(0, 3, 0), uni, Enum.Material.Fabric)
	block(m, "Collar", Vector3.new(0.5, 0.9, 0.05), at(0, 3.5, -0.53), Color3.fromRGB(215, 215, 208))
	block(m, "Skirt", Vector3.new(2.1, 0.9, 1.1), at(0, 1.75, 0), skirt, Enum.Material.Fabric)
	block(m, "LeftLeg", Vector3.new(0.8, 1.4, 0.8), at(-0.5, 0.7, 0), pale)
	block(m, "RightLeg", Vector3.new(0.8, 1.4, 0.8), at(0.5, 0.7, 0), pale)
	block(m, "LeftArm", Vector3.new(1, 2, 1), at(-1.5, 3, 0), uni, Enum.Material.Fabric)
	block(m, "RightArm", Vector3.new(1, 2, 1), at(1.5, 3, 0), uni, Enum.Material.Fabric)
	block(m, "Head", Vector3.new(1.2, 1.2, 1.2), at(0, 4.6, 0), pale)
	block(m, "HairFront", Vector3.new(1.35, 2.6, 0.25), at(0, 4.0, -0.68), hair, Enum.Material.Fabric)
	block(m, "HairTop", Vector3.new(1.35, 0.5, 1.35), at(0, 5.3, 0), hair, Enum.Material.Fabric)
	block(m, "HairBack", Vector3.new(1.35, 2.6, 1.1), at(0, 4.0, 0.15), hair, Enum.Material.Fabric)
	m.PrimaryPart = torso
	return m
end

local function makeChair(baseCF)
	local m = Instance.new("Model")
	m.Name = "AnomalyChair"
	local wood = Color3.fromRGB(196, 160, 112)
	local metal = Color3.fromRGB(138, 142, 148)
	local function at(x, y, z)
		return baseCF * CFrame.new(x, y, z)
	end
	local seat = block(m, "Seat", Vector3.new(1.6, 0.15, 1.7), at(0, 1.62, 0), wood, Enum.Material.Wood)
	block(m, "Back", Vector3.new(1.6, 1.4, 0.15), at(0, 2.6, 0.8), wood, Enum.Material.Wood)
	for _, xz in ipairs({ { -0.7, -0.75 }, { 0.7, -0.75 }, { -0.7, 0.75 }, { 0.7, 0.75 } }) do
		block(m, "Leg", Vector3.new(0.12, 1.6, 0.12), at(xz[1], 0.8, xz[2]), metal, Enum.Material.Metal)
	end
	m.PrimaryPart = seat
	return m
end

local function labelOf(part)
	local gui = part and part:FindFirstChild("Text")
	return gui and gui:FindFirstChild("Label")
end

local function nearestPlayer(pos, maxDist)
	local best, bestD = nil, maxDist
	for _, p in ipairs(api.activePlayers()) do
		local r = api.rootOf(p)
		if r then
			local d = (r.Position - pos).Magnitude
			if d < bestD then
				best, bestD = p, d
			end
		end
	end
	return best, bestD
end

-- ═════════════════════════ 이상현상 정의 ═════════════════════════

-- 1. 복도 조명이 미친 듯이 깜빡인다
def("Flicker", 0, 14, function(st)
	st.saved = {}
	for _, part in ipairs(tagged("CorridorLight")) do
		local light = part:FindFirstChildWhichIsA("Light")
		st.saved[part] = { part.Material, light and light.Enabled }
	end
	local zone = first("BuildingZone")
	for _, p in ipairs(api.activePlayers()) do
		if zone and api.inside(zone, api.rootOf(p).Position) then
			api.say(p, "복도 불빛이 미친 듯이 깜빡인다.", 3)
		end
	end
	task.spawn(function()
		while not st.stopped do
			for part in pairs(st.saved) do
				local on = math.random() < 0.45
				part.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
				local light = part:FindFirstChildWhichIsA("Light")
				if light then
					light.Enabled = on
					light.Brightness = on and 0.9 or 0
				end
			end
			task.wait(math.random(5, 18) / 100)
		end
	end)
end, function(st)
	for part, s in pairs(st.saved) do
		part.Material = s[1]
		local light = part:FindFirstChildWhichIsA("Light")
		if light then
			light.Enabled = s[2] and true or false
			light.Brightness = s[2] and 0.7 or 0
		end
	end
end)

-- 2. 경비실 전화 (수칙 4)
def("Phone", 0, 30, function(st)
	local base = first("Phone")
	local booth = first("BoothZone")
	st.base = base
	st.color = base.Color
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "전화 받기"
	prompt.ObjectText = "경비실 전화"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.Parent = base
	st.prompt = prompt
	task.spawn(function()
		local blink = false
		while not st.stopped and not st.answered do
			api.sayNear(booth.Position, 140, "따르릉— 따르릉— 경비실 전화가 울린다.", 2.6, "yellow")
			api.playSound("PhoneRing", base)
			for _ = 1, 8 do
				if st.stopped or st.answered then
					break
				end
				blink = not blink
				base.Color = blink and Color3.fromRGB(255, 80, 80) or st.color
				task.wait(0.5)
			end
		end
		base.Color = st.color
	end)
	prompt.Triggered:Connect(function(player)
		if st.stopped then
			return
		end
		if st.answered then
			if st.waitingHangup and player == st.answerer then
				st.hungUp = true
				prompt.Enabled = false
			end
			return
		end
		st.answered = true
		st.answerer = player
		prompt.Enabled = false
		if math.random() < 0.45 then
			api.say(player, "교감: 아, " .. Config.HERO_NAME .. " 씨? 첫날이라 걱정돼서요. 순찰 잘 부탁해요.", 4)
			task.delay(4.2, function()
				api.say(player, "교감: …혹시 4층에 불이 켜져 있어도 올라가지 마세요. 우리 학교는 3층까지예요.", 5)
			end)
			task.delay(9.5, function()
				Anomalies.Stop("Phone")
			end)
		else
			api.say(player, "…………", 2)
			task.delay(2.2, function()
				if st.stopped then
					return
				end
				api.say(player, "???: " .. Config.HERO_NAME .. " 씨… " .. Config.HERO_NAME .. " 씨 거기 있죠? 문 좀 열어 줘요. 추워요.", 5, "red")
				st.waitingHangup = true
				prompt.ActionText = "전화 끊기"
				prompt.Enabled = true
				task.delay(6, function()
					if st.stopped then
						return
					end
					if st.hungUp then
						api.addSanity(player, 5, "뚝. 전화를 끊었다. 수칙대로 했다.")
					else
						api.addSanity(player, -30, "수화기 너머에서 웃음소리가 들린다. \"…찾았다.\"")
						api.Effect:FireClient(player, "static")
					end
					Anomalies.Stop("Phone")
				end)
			end)
		end
	end)
end, function(st)
	if st.prompt then
		st.prompt:Destroy()
	end
	if st.base then
		st.base.Color = st.color
	end
	if not st.answered then
		for _, p in ipairs(api.activePlayers()) do
			api.addSanity(p, -8, "아무도 전화를 받지 않았다. 벨소리가 뚝 끊겼다.")
		end
	end
end)

-- 3. 운동장 한가운데 의자 (수칙 5)
def("Chair", 1, 50, function(st)
	local spot = first("ChairSpot")
	local booth = first("BoothZone")
	local pos = Vector3.new(spot.Position.X, spot.Position.Y - 0.05, spot.Position.Z)
	local face = Vector3.new(booth.Position.X, pos.Y, booth.Position.Z)
	st.model = makeChair(CFrame.lookAt(pos, face))
	st.model.Parent = workspace
	st.warned = {}
end, function(st)
	if st.model then
		st.model:Destroy()
	end
end)
function Anomalies.OnChairGaze(player)
	local st = active.Chair
	if not st then
		return
	end
	if not st.warned[player] then
		st.warned[player] = true
		api.addSanity(player, -5, "운동장의 의자를 봐 버렸다. …저 의자, 아까는 없었는데.")
	else
		api.addSanity(player, -5)
	end
end

-- 4. 시계탑이 거꾸로 (수칙 6)
def("ClockBackward", 1, 40, function(st)
	Anomalies.clockBackward = true
	st.warned = {}
	api.sayAll("끼릭… 끼릭… 어디선가 태엽 감기는 소리가 난다.", 4)
	local zone = first("BuildingZone")
	task.spawn(function()
		while not st.stopped do
			for _, p in ipairs(api.activePlayers()) do
				local r = api.rootOf(p)
				if r and zone and api.inside(zone, r.Position) then
					if not st.warned[p] then
						st.warned[p] = true
						api.addSanity(p, -5, "시계탑이 거꾸로 돌고 있다! 건물 밖으로 나가야 해!")
					else
						api.addSanity(p, -3)
					end
				end
			end
			task.wait(1)
		end
	end)
end, function()
	Anomalies.clockBackward = false
end)

-- 5. 복도 끝의 학생 (수칙 7)
def("Student", 0, 45, function(st)
	local spot = pick(tagged("FigureSpot"))
	local pos = Vector3.new(spot.Position.X, spot.Position.Y - 0.05, spot.Position.Z)
	local look = Vector3.new(pos.X > 0 and -1 or 1, 0, 0)
	st.model = makeStudent(CFrame.lookAt(pos, pos + look))
	st.model.Parent = workspace
	api.playSound("Whisper", st.model.PrimaryPart)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "말 걸기"
	prompt.ObjectText = "학생"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt.Parent = st.model.PrimaryPart
	prompt.Triggered:Connect(function(player)
		if st.stopped then
			return
		end
		api.Effect:FireClient(player, "jumpscare")
		api.addSanity(player, -35, "학생: …선생님. 저 아직 집에 못 갔어요.")
		Anomalies.Stop("Student")
	end)
	task.spawn(function()
		while not st.stopped do
			local p, d = nearestPlayer(pos, 9)
			if p then
				api.Effect:FireClient(p, "static")
				api.say(p, "…방금 거기 누가 서 있지 않았나?", 3)
				Anomalies.Stop("Student")
				break
			end
			task.wait(0.2)
		end
	end)
end, function(st)
	if st.model then
		st.model:Destroy()
	end
end)

-- 6. 있을 리 없는 4층 (수칙 3)
def("FourthFloor", 2, 50, function(st)
	local sign
	for _, s in ipairs(tagged("StairSign")) do
		if s:GetAttribute("Floor") == 3 then
			sign = s
		end
	end
	st.sign = sign
	local label = labelOf(sign)
	if label then
		st.text, st.color = label.Text, label.TextColor3
		label.Text = "4F ↑"
		label.TextColor3 = Color3.fromRGB(200, 0, 0)
	end
	st.light = Instance.new("PointLight")
	st.light.Color = Color3.fromRGB(255, 30, 30)
	st.light.Range = 18
	st.light.Brightness = 2
	st.light.Parent = sign
	api.sayNear(sign.Position, 70, "계단 위쪽에서 붉은 불빛이 새어 나온다.", 3, "red")
	local zone = first("RoofStairZone")
	st.hit = {}
	task.spawn(function()
		while not st.stopped do
			for _, p in ipairs(api.activePlayers()) do
				local r = api.rootOf(p)
				if r and zone and not st.hit[p] and api.inside(zone, r.Position) then
					st.hit[p] = true
					api.Effect:FireClient(p, "jumpscare")
					api.addSanity(p, -40, "4층에서… 무언가가 내려다보고 있었다.")
					api.teleportToBooth(p)
				end
			end
			task.wait(0.2)
		end
	end)
end, function(st)
	local label = labelOf(st.sign)
	if label and st.text then
		label.Text = st.text
		label.TextColor3 = st.color
	end
	if st.light then
		st.light:Destroy()
	end
end)

-- 7. 사라진 소녀상 (수칙 8)
def("Statue", 2, 60, function(st)
	local fig = first("StatueFigure")
	local pedestal = first("StatuePedestal")
	st.fig = fig
	st.orig = fig:GetPivot()
	local spot = pick(tagged("FigureSpot"))
	local pos = Vector3.new(spot.Position.X, spot.Position.Y + 0.7, spot.Position.Z)
	local dir = Vector3.new(pos.X > 0 and -1 or 1, 0, 0)
	fig:PivotTo(CFrame.lookAt(pos, pos - dir))
	st.hinted = {}
	task.spawn(function()
		while not st.stopped do
			for _, p in ipairs(api.activePlayers()) do
				local r = api.rootOf(p)
				if r and pedestal and not st.hinted[p] and (r.Position - pedestal.Position).Magnitude < 28 then
					st.hinted[p] = true
					api.say(p, "…책 읽는 소녀상이 받침대 위에 없다.", 3.5)
				end
			end
			local p = nearestPlayer(pos, 9)
			if p then
				api.Effect:FireClient(p, "jumpscare")
				api.addSanity(p, -30, "소녀상: 이 책, 다 읽었어. …다음은 너야.")
				Anomalies.Stop("Statue")
				break
			end
			task.wait(0.2)
		end
	end)
end, function(st)
	if st.fig and st.orig then
		st.fig:PivotTo(st.orig)
	end
end)

-- 8. 교내 방송
def("Broadcast", 0, 14, function(st)
	local onair = first("OnAirSign")
	local label = labelOf(onair)
	if label then
		st.labelColor = label.TextColor3
		label.TextColor3 = Color3.fromRGB(255, 40, 40)
	end
	st.onair = onair
	st.saved = {}
	for _, part in ipairs(tagged("CorridorLight")) do
		local light = part:FindFirstChildWhichIsA("Light")
		st.saved[part] = { part.Material, light and light.Enabled }
		part.Material = Enum.Material.SmoothPlastic
		if light then
			light.Enabled = false
		end
	end
	api.playSound("Static", onair)
	for _, p in ipairs(api.activePlayers()) do
		api.Effect:FireClient(p, "static")
	end
	api.sayAll("[교내 방송] 지지직… 아직 학교에 남아 있는 " .. Config.HERO_NAME .. " 학생은…", 4.5, "static")
	task.delay(4.6, function()
		if not st.stopped then
			api.sayAll("[교내 방송] …3학년 4반 교실로… 와 주세요… 다들 기다리고 있어요…", 5, "static")
		end
	end)
end, function(st)
	local label = labelOf(st.onair)
	if label and st.labelColor then
		label.TextColor3 = st.labelColor
	end
	for part, s in pairs(st.saved or {}) do
		part.Material = s[1]
		local light = part:FindFirstChildWhichIsA("Light")
		if light then
			light.Enabled = s[2] and true or false
		end
	end
end)

-- 9. 칠판 글씨
def("Blackboard", 1, 45, function(st)
	st.saved = {}
	local line = pick({ "뒤를 보지 마", "아직 안 갔어", Config.HERO_NAME .. " 선생님 안녕하세요", "4층으로 와", "다 같이 기다리는 중" })
	for _, b in ipairs(tagged("Blackboard")) do
		local label = labelOf(b)
		if label then
			st.saved[label] = { label.Text, label.TextColor3 }
			label.Text = line
			label.TextColor3 = Color3.fromRGB(255, 225, 225)
		end
	end
end, function(st)
	for label, s in pairs(st.saved) do
		label.Text = s[1]
		label.TextColor3 = s[2]
	end
end)

-- 10. 교실 책상이 전부 뒤로 돌아 있다
def("Desks", 0, 70, function(st)
	local rooms = tagged("Classroom")
	local room = pick(rooms)
	st.saved = {}
	for _, m in ipairs(room:GetChildren()) do
		if m:IsA("Model") and CollectionService:HasTag(m, "DeskSet") then
			local cf = m:GetBoundingBox()
			local turn = cf * CFrame.Angles(0, math.rad(180), 0) * cf:Inverse()
			for _, part in ipairs(m:GetDescendants()) do
				if part:IsA("BasePart") then
					st.saved[part] = part.CFrame
					part.CFrame = turn * part.CFrame
				end
			end
		end
	end
	api.sayAll("어딘가에서 의자 끄는 소리가 한꺼번에 들렸다. 드르륵—", 3.5)
end, function(st)
	for part, cf in pairs(st.saved) do
		part.CFrame = cf
	end
end)

-- 11. 미술실 석고상이 고개를 돌린다
def("Bust", 3, 60, function(st)
	local bust = first("PlasterBust")
	st.bust = bust
	st.orig = bust:GetPivot()
	st.told = {}
	task.spawn(function()
		while not st.stopped do
			local p, d = nearestPlayer(st.orig.Position, 70)
			if p then
				local r = api.rootOf(p)
				local target = Vector3.new(r.Position.X, st.orig.Position.Y, r.Position.Z)
				bust:PivotTo(CFrame.lookAt(st.orig.Position, target) * CFrame.Angles(0, math.rad(90), 0))
				if d < 30 and not st.told[p] then
					st.told[p] = true
					api.say(p, "석고상이… 이쪽을 보고 있다?", 3)
				end
			end
			task.wait(0.1)
		end
	end)
end, function(st)
	if st.bust and st.orig then
		st.bust:PivotTo(st.orig)
	end
end)

-- 12. 정문을 두드리는 소리 (수칙 1과 연결)
def("Knock", 3, 30, function(st)
	local lock = first("GateLock")
	local lines = {
		"쾅! 쾅! 쾅! 누군가 정문 철문을 두드린다.",
		"학생 목소리: 경비 아저씨! 문 좀 열어 주세요! 집에 가야 돼요!",
		"학생 목소리: 아저씨, 거기 있는 거 다 알아요.",
		"…철문 틈으로 하얀 손가락이 꼼지락거린다.",
	}
	task.spawn(function()
		local i = 1
		while not st.stopped do
			api.sayNear(lock.Position, 170, lines[i], 4, i == 4 and "red" or "white")
			api.playSound("Knock", lock)
			for _, p in ipairs(api.activePlayers()) do
				local r = api.rootOf(p)
				if r and (r.Position - lock.Position).Magnitude < 60 then
					api.Effect:FireClient(p, "shake")
				end
			end
			i = i % #lines + 1
			task.wait(6)
		end
	end)
end)

-- 13. CCTV 화면
def("CCTV", 0, 25, function(st)
	st.saved = {}
	local screens = tagged("CCTVScreen")
	for _, s in ipairs(screens) do
		st.saved[s] = s.Color
	end
	api.sayNear(first("BoothZone").Position, 40, "CCTV 화면이 하나씩 빨갛게 변한다.", 3, "red")
	task.spawn(function()
		for _, s in ipairs(screens) do
			if st.stopped then
				return
			end
			s.Color = Color3.fromRGB(150, 20, 20)
			task.wait(0.8)
		end
		for _, s in ipairs(screens) do
			if s:GetAttribute("Cam") == 4 then
				s.Color = Color3.fromRGB(230, 230, 230)
			end
		end
		api.sayNear(first("BoothZone").Position, 40, "4번 화면에… 누군가 카메라를 올려다보며 서 있다.", 4, "red")
	end)
end, function(st)
	for s, c in pairs(st.saved) do
		s.Color = c
	end
end)

-- ═════════════════════════ 관리 ═════════════════════════
function Anomalies.Trigger(name)
	local d = findDef(name)
	if not d or active[name] then
		return
	end
	local st = {}
	active[name] = st
	lastName = name
	local ok, err = pcall(d.start, st)
	if not ok then
		warn("[Anomaly] " .. name .. " 시작 실패: " .. tostring(err))
		active[name] = nil
		st.stopped = true
		return
	end
	task.delay(d.duration, function()
		if active[name] == st then
			Anomalies.Stop(name)
		end
	end)
end

function Anomalies.Stop(name)
	local st = active[name]
	if not st then
		return
	end
	active[name] = nil
	st.stopped = true
	local d = findDef(name)
	local ok, err = pcall(d.stop, st)
	if not ok then
		warn("[Anomaly] " .. name .. " 정리 실패: " .. tostring(err))
	end
end

function Anomalies.StopAll()
	generation = generation + 1
	local names = {}
	for name in pairs(active) do
		table.insert(names, name)
	end
	for _, name in ipairs(names) do
		Anomalies.Stop(name)
	end
end

function Anomalies.Start(a)
	api = a
	generation = generation + 1
	local myGen = generation
	task.spawn(function()
		task.wait(Config.FIRST_ANOMALY_DELAY)
		while myGen == generation do
			local count = 0
			for _ in pairs(active) do
				count = count + 1
			end
			if count < Config.MAX_ACTIVE_ANOMALIES and #api.activePlayers() > 0 then
				local pool = {}
				for _, d in ipairs(defs) do
					if not active[d.name] and d.name ~= lastName and api.hour() >= d.minHour then
						table.insert(pool, d)
					end
				end
				if #pool > 0 then
					Anomalies.Trigger(pick(pool).name)
				end
			end
			task.wait(math.random(Config.ANOMALY_MIN_GAP, Config.ANOMALY_MAX_GAP))
		end
	end)
end

Anomalies.Active = active
return Anomalies
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX00000006">
			<Properties>
				<string name="Name">GuardOutfit</string>
				<ProtectedString name="Source"><![CDATA[-- 경비원 공유 스킨 (무료)
-- 모든 플레이어를 남색 경비복 + 경비 모자 + 손전등 차림의 "경비원 공유"로 바꿉니다.
-- 옷 이미지는 roblox/clothes/*.png 를 Studio에서 무료 업로드한 뒤 Config에 ID를 넣으면 적용됩니다.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))

local GuardOutfit = {}

local NAVY = Color3.fromRGB(36, 46, 74)
local NAVY_DARK = Color3.fromRGB(30, 36, 52)
local BLACK = Color3.fromRGB(16, 16, 18)
local GOLD = Color3.fromRGB(222, 184, 74)

local function weldPart(parent, attachTo, name, size, offset, color, mat, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	if shape then
		p.Shape = shape
	end
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = attachTo.CFrame * offset
	local w = Instance.new("WeldConstraint")
	w.Part0 = attachTo
	w.Part1 = p
	w.Parent = p
	p.Parent = parent
	return p
end

local function applyDescription(humanoid)
	local ok, desc = pcall(function()
		return humanoid:GetAppliedDescription()
	end)
	if not ok or not desc then
		return
	end
	desc.Shirt = 0
	desc.Pants = 0
	desc.GraphicTShirt = 0
	pcall(function()
		desc:SetAccessories({}, true) -- 모자·가방 등 전부 벗기기
	end)
	desc.HatAccessory = ""
	desc.FaceAccessory = ""
	desc.BackAccessory = ""
	desc.FrontAccessory = ""
	desc.NeckAccessory = ""
	desc.ShouldersAccessory = ""
	desc.WaistAccessory = ""
	desc.HairAccessory = Config.HAIR_ACCESSORY_ID ~= 0 and tostring(Config.HAIR_ACCESSORY_ID) or ""
	if Config.FACE_ID ~= 0 then
		desc.Face = Config.FACE_ID
	end
	local skin = Config.SKIN_COLOR
	desc.HeadColor = skin
	if Config.SHIRT_IMAGE_ID ~= 0 then
		desc.TorsoColor = skin
		desc.LeftArmColor = skin
		desc.RightArmColor = skin
	else
		-- 옷 이미지가 없으면 몸 색으로 유니폼 흉내
		desc.TorsoColor = NAVY
		desc.LeftArmColor = NAVY
		desc.RightArmColor = NAVY
	end
	desc.LeftLegColor = NAVY_DARK
	desc.RightLegColor = NAVY_DARK
	pcall(function()
		humanoid:ApplyDescription(desc)
	end)
end

function GuardOutfit.Apply(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local head = character:WaitForChild("Head", 10)
	if not humanoid or not head then
		return
	end
	if player:HasAppearanceLoaded() == false then
		player.CharacterAppearanceLoaded:Wait()
	end
	if character.Parent == nil then
		return
	end
	applyDescription(humanoid)
	head = character:FindFirstChild("Head") or head

	-- 셔츠·바지 (업로드한 이미지 ID)
	for _, c in ipairs(character:GetChildren()) do
		if c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic") then
			c:Destroy()
		end
	end
	if Config.SHIRT_IMAGE_ID ~= 0 then
		local s = Instance.new("Shirt")
		s.ShirtTemplate = "rbxassetid://" .. Config.SHIRT_IMAGE_ID
		s.Parent = character
	end
	if Config.PANTS_IMAGE_ID ~= 0 then
		local p = Instance.new("Pants")
		p.PantsTemplate = "rbxassetid://" .. Config.PANTS_IMAGE_ID
		p.Parent = character
	end

	humanoid.DisplayName = "경비원 " .. Config.HERO_NAME
	humanoid.NameDisplayDistance = 30

	local outfit = character:FindFirstChild("GuardOutfit")
	if outfit then
		outfit:Destroy()
	end
	outfit = Instance.new("Folder")
	outfit.Name = "GuardOutfit"
	outfit.Parent = character

	local hs = head.Size
	-- 짧은 검은 머리 (무료 머리 아이템을 안 쓸 때)
	if Config.HAIR_ACCESSORY_ID == 0 then
		weldPart(outfit, head, "Hair", Vector3.new(hs.X * 1.06, hs.Y * 0.32, hs.Z * 1.06), CFrame.new(0, hs.Y * 0.36, hs.Z * 0.04), Color3.fromRGB(26, 20, 16), Enum.Material.SmoothPlastic)
		weldPart(outfit, head, "HairBack", Vector3.new(hs.X * 1.06, hs.Y * 0.5, hs.Z * 0.2), CFrame.new(0, hs.Y * 0.12, hs.Z * 0.47), Color3.fromRGB(26, 20, 16), Enum.Material.SmoothPlastic)
	end
	-- 경비 모자
	local crownD = hs.X * 1.2
	weldPart(outfit, head, "CapCrown", Vector3.new(hs.Y * 0.42, crownD, crownD), CFrame.new(0, hs.Y * 0.62, 0) * CFrame.Angles(0, 0, math.rad(90)), NAVY, Enum.Material.Fabric, Enum.PartType.Cylinder)
	weldPart(outfit, head, "CapBand", Vector3.new(hs.Y * 0.14, crownD * 0.94, crownD * 0.94), CFrame.new(0, hs.Y * 0.42, 0) * CFrame.Angles(0, 0, math.rad(90)), BLACK, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
	weldPart(outfit, head, "CapVisor", Vector3.new(hs.X * 0.95, 0.08, hs.Z * 0.5), CFrame.new(0, hs.Y * 0.4, -hs.Z * 0.66) * CFrame.Angles(math.rad(-12), 0, 0), BLACK, Enum.Material.SmoothPlastic)
	weldPart(outfit, head, "CapBadge", Vector3.new(hs.X * 0.24, hs.Y * 0.24, 0.06), CFrame.new(0, hs.Y * 0.66, -crownD * 0.5), GOLD, Enum.Material.Metal)

	-- 손전등 (오른손에 들고 있음. 빛은 각자 화면에서 켜짐 → Client 스크립트)
	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if hand then
		local downOffset = hand.Name == "Right Arm" and -hand.Size.Y * 0.45 or -hand.Size.Y * 0.2
		local body = weldPart(outfit, hand, "Flashlight", Vector3.new(1.1, 0.34, 0.34), CFrame.new(0, downOffset, -0.45) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(34, 34, 36), Enum.Material.Metal, Enum.PartType.Cylinder)
		weldPart(outfit, body, "Lens", Vector3.new(0.08, 0.36, 0.36), CFrame.new(0.56, 0, 0), Color3.fromRGB(255, 246, 216), Enum.Material.Neon, Enum.PartType.Cylinder)
	end
end

return GuardOutfit
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX00000007">
			<Properties>
				<string name="Name">Main</string>
				<ProtectedString name="Source"><![CDATA[-- 싸이 뛰어! 나폴리탄 괴담: 송천고 야간 경비 — 서버 메인
-- 맵을 짓고, 근무 시간(22:00~06:00)·순찰·정신력·엔딩을 관리합니다.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))

-- 맵을 다 지을 때까지 캐릭터를 만들지 않음 (허공으로 떨어지지 않게)
Players.CharacterAutoLoads = false

-- ───────── 리모트 ─────────
local remotes = Instance.new("Folder")
remotes.Name = "NightShiftRemotes"
local function remote(name)
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
	return r
end
local Subtitle = remote("Subtitle") -- (글, 초, 색이름)
local IntroFinished = remote("IntroFinished")
local ChairGaze = remote("ChairGaze")
local Effect = remote("Effect") -- (종류)
local Ending = remote("Ending") -- (종류)
remotes.Parent = ReplicatedStorage

-- ───────── 맵 ─────────
local Builder = require(ServerScriptService:WaitForChild("SchoolBuilder"))
local school = Builder.Build(workspace, true)
workspace:SetAttribute("MapReady", true)

local function tagged(tag)
	return CollectionService:GetTagged(tag)
end
local function first(tag)
	return tagged(tag)[1]
end

-- ───────── 밤 분위기 ─────────
Lighting.ClockTime = 22
Lighting.Brightness = 0.6
Lighting.Ambient = Color3.fromRGB(18, 20, 30)
Lighting.OutdoorAmbient = Color3.fromRGB(48, 54, 76)
Lighting.EnvironmentDiffuseScale = 0.4
Lighting.EnvironmentSpecularScale = 0.6
Lighting.GlobalShadows = true
Lighting.FogColor = Color3.fromRGB(14, 18, 30)
Lighting.FogStart = 60
Lighting.FogEnd = 650
local function effect(class, props)
	local e = Lighting:FindFirstChildOfClass(class) or Instance.new(class)
	for k, v in pairs(props) do
		e[k] = v
	end
	e.Parent = Lighting
	return e
end
effect("Atmosphere", { Density = 0.38, Offset = 0.1, Color = Color3.fromRGB(70, 80, 110), Decay = Color3.fromRGB(20, 22, 36), Glare = 0, Haze = 1.6 })
effect("ColorCorrectionEffect", { Brightness = 0.02, Contrast = 0.12, Saturation = -0.2, TintColor = Color3.fromRGB(220, 228, 255) })
effect("BloomEffect", { Intensity = 0.7, Size = 28, Threshold = 1.4 })
effect("SunRaysEffect", { Intensity = 0.02, Spread = 0.6 })

local function playSound(name, parent, looped)
	local id = Config.SOUNDS[name]
	if not id or id == 0 then
		return nil
	end
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://" .. id
	s.Looped = looped or false
	s.RollOffMaxDistance = 200
	s.Parent = parent or workspace
	s:Play()
	if not looped then
		s.Ended:Connect(function()
			s:Destroy()
		end)
	end
	return s
end
playSound("Ambience", workspace, true)

-- ───────── 공통 도구 ─────────
local api = {}
api.Subtitle = Subtitle
api.Effect = Effect
api.playSound = playSound
api.school = school

local function rootOf(player)
	local ch = player.Character
	return ch and ch:FindFirstChild("HumanoidRootPart")
end
api.rootOf = rootOf

function api.inside(part, pos)
	local rel = part.CFrame:PointToObjectSpace(pos)
	local h = part.Size / 2
	return math.abs(rel.X) <= h.X and math.abs(rel.Y) <= h.Y and math.abs(rel.Z) <= h.Z
end

function api.activePlayers()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p:GetAttribute("IntroDone") and not p:GetAttribute("Ended") then
			local ch = p.Character
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 and rootOf(p) then
				table.insert(list, p)
			end
		end
	end
	return list
end

function api.say(player, text, seconds, color)
	Subtitle:FireClient(player, text, seconds or 4, color or "white")
end
function api.sayAll(text, seconds, color)
	for _, p in ipairs(api.activePlayers()) do
		api.say(p, text, seconds, color)
	end
end
function api.sayNear(pos, radius, text, seconds, color)
	for _, p in ipairs(api.activePlayers()) do
		local r = rootOf(p)
		if r and (r.Position - pos).Magnitude <= radius then
			api.say(p, text, seconds, color)
		end
	end
end

function api.teleportToBooth(player)
	local spawnPart = first("BoothSpawn")
	local r = rootOf(player)
	if spawnPart and r then
		player.Character:PivotTo(CFrame.new(spawnPart.Position + Vector3.new(0, 3.5, 0)) * CFrame.Angles(0, math.rad(180), 0))
	end
end

local endFor -- 아래에서 정의

function api.addSanity(player, delta, reason)
	if not player:GetAttribute("IntroDone") or player:GetAttribute("Ended") then
		return
	end
	local s = math.clamp((player:GetAttribute("Sanity") or Config.START_SANITY) + delta, 0, 100)
	player:SetAttribute("Sanity", s)
	if reason then
		api.say(player, reason, 4, delta < 0 and "red" or "green")
	end
	if delta < 0 then
		Effect:FireClient(player, "hurt")
	end
	if s <= 0 then
		endFor(player, "SANITY")
	end
end

-- ───────── 근무 시간 ─────────
local shift = { running = false, minutes = 0, lastHour = 0 }
workspace:SetAttribute("ShiftMinutes", 0)
workspace:SetAttribute("ShiftRunning", false)

function api.hour()
	return math.floor(shift.minutes / 60) -- 0 = 22시대, 7 = 05시대
end
function api.shiftRunning()
	return shift.running
end

local function resetPatrol(player)
	for f = 1, 3 do
		player:SetAttribute("Patrol" .. f, false)
	end
end

function endFor(player, kind)
	if player:GetAttribute("Ended") then
		return
	end
	player:SetAttribute("Ended", true)
	Ending:FireClient(player, kind)
	if kind ~= "CLEAR" then
		task.delay(9, function()
			if player.Parent then
				player:SetAttribute("Sanity", Config.START_SANITY)
				player:SetAttribute("Ended", false)
				resetPatrol(player)
				player:LoadCharacter()
			end
		end)
	end
end
api.endFor = endFor

local Anomalies = require(ServerScriptService:WaitForChild("Anomalies"))

local function startShift()
	if shift.running then
		return
	end
	shift.running = true
	shift.minutes = 0
	shift.lastHour = 0
	workspace:SetAttribute("ShiftRunning", true)
	for _, p in ipairs(Players:GetPlayers()) do
		resetPatrol(p)
	end
	Anomalies.Start(api)
end

local function finishShift()
	shift.running = false
	workspace:SetAttribute("ShiftRunning", false)
	Anomalies.StopAll()
	for _, p in ipairs(api.activePlayers()) do
		endFor(p, "CLEAR")
	end
	-- 20초 뒤 새 밤 시작 (다시 하기)
	task.delay(20, function()
		for _, p in ipairs(Players:GetPlayers()) do
			p:SetAttribute("Ended", false)
			p:SetAttribute("Sanity", Config.START_SANITY)
			resetPatrol(p)
			if p:GetAttribute("IntroDone") then
				p:LoadCharacter()
			end
		end
		shift.minutes = 0
		workspace:SetAttribute("ShiftMinutes", 0)
		if #Players:GetPlayers() > 0 then
			startShift()
		end
	end)
end

local function onHourPassed(h)
	-- 정각: 순찰 확인
	for _, p in ipairs(api.activePlayers()) do
		local done = 0
		for f = 1, 3 do
			if p:GetAttribute("Patrol" .. f) then
				done = done + 1
			end
		end
		if done < 3 then
			api.addSanity(p, -Config.PATROL_MISS_PENALTY, string.format("순찰을 다 돌지 못했다 (%d/3). 어딘가에서 발소리가 따라온다…", done))
		else
			api.say(p, "순찰 완료. 무사히 한 시간을 넘겼다.", 3, "green")
		end
		resetPatrol(p)
	end
	local clockHour = (Config.SHIFT_START_HOUR + h) % 24
	if clockHour == 0 then
		api.sayAll("자정. 학교 종이 울렸다. …아무도 없는데.", 4)
		playSound("Bell", first("ClockCenter"))
	elseif clockHour == 3 then
		api.sayAll("새벽 3시. 이상하게 조용하다.", 4)
	end
end

-- ───────── 시계탑 ─────────
local clockCenter = first("ClockCenter")
local hourHand = first("ClockHour")
local minuteHand = first("ClockMinute")
local handZ = {}
if hourHand and minuteHand then
	handZ[hourHand] = hourHand.Position.Z
	handZ[minuteHand] = minuteHand.Position.Z
end
local backwardAngle = 0
local function setHand(hand, deg)
	local c = clockCenter.Position
	hand.CFrame = CFrame.new(c.X, c.Y, handZ[hand]) * CFrame.Angles(0, 0, -math.rad(deg)) * CFrame.new(0, hand.Size.Y / 2, 0)
end

-- ───────── 매 프레임 ─────────
RunService.Heartbeat:Connect(function(dt)
	if shift.running then
		shift.minutes = shift.minutes + dt * 60 / Config.SECONDS_PER_GAME_HOUR
		local h = math.floor(shift.minutes / 60)
		if h > shift.lastHour then
			shift.lastHour = h
			if h >= Config.SHIFT_HOURS then
				shift.minutes = Config.SHIFT_HOURS * 60
				finishShift()
			else
				onHourPassed(h)
			end
		end
		workspace:SetAttribute("ShiftMinutes", shift.minutes)
	end
	local hours = Config.SHIFT_START_HOUR + shift.minutes / 60
	Lighting.ClockTime = hours % 24
	if clockCenter and hourHand and minuteHand then
		if Anomalies.clockBackward then
			backwardAngle = backwardAngle - dt * 240
			setHand(minuteHand, backwardAngle)
			setHand(hourHand, backwardAngle / 12)
		else
			setHand(minuteHand, (shift.minutes % 60) / 60 * 360)
			setHand(hourHand, (hours % 12) / 12 * 360)
			backwardAngle = (shift.minutes % 60) / 60 * 360
		end
	end
end)

-- ───────── 늘 깜빡이는 조명 ─────────
task.spawn(function()
	while true do
		task.wait(math.random(15, 40) / 10)
		for _, part in ipairs(tagged("FlickerLight")) do
			if math.random() < 0.35 then
				local light = part:FindFirstChildWhichIsA("Light")
				task.spawn(function()
					for _ = 1, math.random(2, 5) do
						if light then
							light.Enabled = false
						end
						part.Material = Enum.Material.SmoothPlastic
						task.wait(math.random(3, 12) / 100)
						if light then
							light.Enabled = light:GetAttribute("Off") ~= true
						end
						if not (light and light:GetAttribute("Off")) then
							part.Material = Enum.Material.Neon
						end
						task.wait(math.random(3, 20) / 100)
					end
				end)
			end
		end
	end
end)
-- 꺼져 있는 등은 깜빡일 때 켜지지 않도록 표시
for _, part in ipairs(tagged("FlickerLight")) do
	local light = part:FindFirstChildWhichIsA("Light")
	if light and not light.Enabled then
		light:SetAttribute("Off", true)
	end
end

-- ───────── 순찰함 ─────────
for _, box in ipairs(tagged("PatrolPoint")) do
	local floor = box:GetAttribute("Floor")
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "순찰 체크"
	prompt.ObjectText = "순찰함 " .. floor .. "F"
	prompt.HoldDuration = 0.6
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.Parent = box
	prompt.Triggered:Connect(function(player)
		if not shift.running or player:GetAttribute("Ended") then
			return
		end
		if player:GetAttribute("Patrol" .. floor) then
			api.say(player, floor .. "층은 이번 시간에 이미 체크했다.", 2.5)
			return
		end
		player:SetAttribute("Patrol" .. floor, true)
		local done = 0
		for f = 1, 3 do
			if player:GetAttribute("Patrol" .. f) then
				done = done + 1
			end
		end
		api.say(player, string.format("%dF 순찰 완료 (%d/3)", floor, done), 2.5, "green")
	end)
end

-- ───────── 정문 ─────────
local gateModel = school:FindFirstChild("MainGate", true)
local gateLock = first("GateLock")
local gateOpen = false
local function moveGate(open)
	if not gateModel or gateOpen == open then
		return
	end
	gateOpen = open
	local base = gateModel:GetAttribute("ClosedPivot")
	if not base then
		gateModel:SetAttribute("ClosedPivot", gateModel:GetPivot())
		base = gateModel:GetPivot()
	end
	local target = open and (base * CFrame.new(-28, 0, 0)) or base
	local v = Instance.new("CFrameValue")
	v.Value = gateModel:GetPivot()
	v.Changed:Connect(function(cf)
		gateModel:PivotTo(cf)
	end)
	local tw = TweenService:Create(v, TweenInfo.new(3, Enum.EasingStyle.Sine), { Value = target })
	tw:Play()
	tw.Completed:Connect(function()
		v:Destroy()
	end)
	playSound("GateClose", gateLock)
end
if gateModel then
	gateModel:SetAttribute("ClosedPivot", gateModel:GetPivot())
end
if gateLock then
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "정문 열기"
	prompt.ObjectText = "정문"
	prompt.HoldDuration = 1.5
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = gateLock
	prompt.Triggered:Connect(function(player)
		if shift.running and shift.minutes < Config.SHIFT_HOURS * 60 then
			-- 수칙 1번 위반
			moveGate(true)
			Effect:FireClient(player, "jumpscare")
			endFor(player, "GATE")
			task.delay(6, function()
				moveGate(false)
			end)
		else
			moveGate(true)
			api.say(player, "아침 공기가 들어온다. 수고했어, " .. Config.HERO_NAME .. ".", 4, "green")
			task.delay(12, function()
				moveGate(false)
			end)
		end
	end)
end

-- ───────── 플레이어 ─────────
local GuardOutfit = require(ServerScriptService:WaitForChild("GuardOutfit"))

local function onCharacter(player, character)
	local hrp = character:WaitForChild("HumanoidRootPart", 10)
	local hum = character:WaitForChild("Humanoid", 10)
	if not hrp or not hum then
		return
	end
	task.wait()
	api.teleportToBooth(player)
	if not player:GetAttribute("IntroDone") then
		hrp.Anchored = true -- 인트로 동안 가만히
	end
	hum.Died:Connect(function()
		task.delay(Players.RespawnTime, function()
			if player.Parent and player.Character == character then
				player:LoadCharacter()
			end
		end)
	end)
	GuardOutfit.Apply(player, character)
end

Players.PlayerAdded:Connect(function(player)
	player:SetAttribute("Sanity", Config.START_SANITY)
	player:SetAttribute("IntroDone", false)
	player:SetAttribute("Ended", false)
	resetPatrol(player)
	player.CharacterAdded:Connect(function(ch)
		onCharacter(player, ch)
	end)
	player:LoadCharacter()
end)
for _, player in ipairs(Players:GetPlayers()) do
	player:SetAttribute("Sanity", Config.START_SANITY)
	player:SetAttribute("IntroDone", player:GetAttribute("IntroDone") or false)
	resetPatrol(player)
	player.CharacterAdded:Connect(function(ch)
		onCharacter(player, ch)
	end)
	task.spawn(function()
		player:LoadCharacter()
	end)
end

IntroFinished.OnServerEvent:Connect(function(player)
	if player:GetAttribute("IntroDone") then
		return
	end
	player:SetAttribute("IntroDone", true)
	player:SetAttribute("Sanity", Config.START_SANITY)
	local hrp = rootOf(player)
	if hrp then
		hrp.Anchored = false
	end
	api.teleportToBooth(player)
	startShift()
end)

ChairGaze.OnServerEvent:Connect(function(player)
	Anomalies.OnChairGaze(player)
end)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX00000008">
			<Properties>
				<string name="Name">SchoolBuilder</string>
				<ProtectedString name="Source"><![CDATA[-- 송천고등학교 맵 빌더
-- MapData*.lua (tools/generate.js 가 만든 데이터)를 읽어서 파트로 지어 줍니다.
--
-- Studio에서 맵을 미리 지어 두고 싶으면 (편집 모드에서) 명령 바에 붙여 넣으세요:
--   require(game.ServerScriptService.SchoolBuilder).Build(workspace, false)
-- 그 다음 파일 저장하면 맵이 장소에 그대로 남습니다. (이미 있으면 게임 시작 때 다시 짓지 않아요)

local HttpService = game:GetService("HttpService")
local CollectionService = game:GetService("CollectionService")

local Builder = {}

local SHAPES = { [1] = Enum.PartType.Ball, [2] = Enum.PartType.Cylinder }

local function material(name)
	local ok, m = pcall(function()
		return Enum.Material[name]
	end)
	if ok and m then
		return m
	end
	return Enum.Material.SmoothPlastic
end

local function font(name)
	local ok, f = pcall(function()
		return Enum.Font[name]
	end)
	if ok and f then
		return f
	end
	return Enum.Font.GothamBold
end

local function band(a, b)
	return math.floor(a / b) % 2 == 1
end

function Builder.Build(parent, yield)
	parent = parent or workspace
	if yield == nil then
		yield = true
	end
	local existing = parent:FindFirstChild("School")
	if existing then
		return existing
	end

	local header = HttpService:JSONDecode(require(script.MapData0))
	local colors, mats = {}, {}
	for i, c in ipairs(header.colors) do
		colors[i - 1] = Color3.fromRGB(c[1], c[2], c[3])
	end
	for i, m in ipairs(header.mats) do
		mats[i - 1] = material(m)
	end

	-- 그룹(모델) 만들기: 경로 순서대로 부모가 먼저 나온다
	local groupObj, byPath = {}, {}
	for i, path in ipairs(header.groups) do
		local segs = string.split(path, "/")
		local obj
		if #segs == 1 then
			obj = Instance.new("Folder")
		else
			obj = Instance.new("Model")
		end
		obj.Name = segs[#segs]
		if #segs > 1 then
			local parentPath = table.concat(segs, "/", 1, #segs - 1)
			obj.Parent = byPath[parentPath]
		end
		byPath[path] = obj
		groupObj[i - 1] = obj
	end
	local root = groupObj[0]

	-- 파트
	local parts = {}
	local count = 0
	for chunk = 1, header.partChunks do
		local list = HttpService:JSONDecode(require(script["MapData" .. chunk]))
		for _, r in ipairs(list) do
			local shape = r[15]
			local p
			if shape == 3 then
				p = Instance.new("WedgePart")
			else
				p = Instance.new("Part")
				if SHAPES[shape] then
					p.Shape = SHAPES[shape]
				end
			end
			p.Name = r[2]
			p.Anchored = true
			p.Size = Vector3.new(r[3], r[4], r[5])
			p.CFrame = CFrame.new(r[6], r[7], r[8]) * CFrame.Angles(math.rad(r[9]), math.rad(r[10]), math.rad(r[11]))
			p.Color = colors[r[12]]
			p.Material = mats[r[13]]
			p.Transparency = r[14]
			p.TopSurface = Enum.SurfaceType.Smooth
			p.BottomSurface = Enum.SurfaceType.Smooth
			local flags = r[16]
			if band(flags, 1) then
				p.CanCollide = false
			end
			if band(flags, 2) then
				p.CastShadow = false
			end
			if band(flags, 8) then
				-- 판정용 투명 영역
				p.CanCollide = false
				p.CanTouch = false
				p.CastShadow = false
				p.Locked = true
			end
			local g = groupObj[r[1]]
			p.Parent = g
			if band(flags, 4) and g:IsA("Model") then
				g.PrimaryPart = p
			end
			parts[count] = p
			count = count + 1
			if yield and count % 1500 == 0 then
				task.wait()
			end
		end
	end

	-- 조명
	for _, L in ipairs(header.lights) do
		local p = parts[L[1]]
		local light
		if L[2] == 1 then
			light = Instance.new("SpotLight")
			light.Angle = L[8]
			light.Face = Enum.NormalId[L[7]]
		elseif L[2] == 2 then
			light = Instance.new("SurfaceLight")
			light.Angle = math.min(L[8], 90)
			light.Face = Enum.NormalId[L[7]]
		else
			light = Instance.new("PointLight")
		end
		light.Range = math.min(L[3], 60)
		light.Brightness = L[4]
		light.Color = colors[L[5]]
		light.Enabled = L[6] == 1
		light.Shadows = L[9] == 1
		light.Parent = p
	end

	-- 글씨 (SurfaceGui)
	for _, T in ipairs(header.texts) do
		local p = parts[T[1]]
		local gui = Instance.new("SurfaceGui")
		gui.Name = "Text"
		gui.Face = Enum.NormalId[T[2]]
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = T[10]
		gui.LightInfluence = T[8]
		if T[8] < 1 then
			gui.Brightness = 1.6
		end
		gui.ResetOnSpawn = false
		local label = Instance.new("TextLabel")
		label.Name = "Label"
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundColor3 = colors[T[5]]
		label.BackgroundTransparency = T[6]
		label.BorderSizePixel = 0
		label.TextColor3 = colors[T[4]]
		label.Font = font(T[7])
		label.Text = T[3]
		label.TextScaled = true
		label.TextWrapped = true
		if T[9] == "Left" then
			label.TextXAlignment = Enum.TextXAlignment.Left
			local pad = Instance.new("UIPadding")
			pad.PaddingLeft = UDim.new(0.04, 0)
			pad.PaddingRight = UDim.new(0.04, 0)
			pad.PaddingTop = UDim.new(0.03, 0)
			pad.PaddingBottom = UDim.new(0.03, 0)
			pad.Parent = label
		end
		label.Parent = gui
		gui.Parent = p
	end

	-- PrimaryPart가 없는 모델은 기준점(피벗)을 모델 한가운데로
	for _, g in pairs(groupObj) do
		if g:IsA("Model") and not g.PrimaryPart and #g:GetChildren() > 0 then
			local ok, cf = pcall(function()
				return g:GetBoundingBox()
			end)
			if ok and cf then
				g.WorldPivot = CFrame.new(cf.Position)
			end
		end
	end

	-- 태그와 속성 (스크립트가 찾을 때 씀)
	for _, t in ipairs(header.tags) do
		CollectionService:AddTag(parts[t[1]], t[2])
	end
	for _, t in ipairs(header.gtags) do
		CollectionService:AddTag(groupObj[t[1]], t[2])
	end
	for _, a in ipairs(header.attrs) do
		parts[a[1]]:SetAttribute(a[2], a[3])
	end

	root.Parent = parent
	return root
end

return Builder
]]></ProtectedString>
			</Properties>
			<Item class="ModuleScript" referent="RBX00000009">
				<Properties>
					<string name="Name">MapData0</string>
